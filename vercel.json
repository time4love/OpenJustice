{
  "functions": {
    "**/*": {
      "maxDuration": 60
    }
  },
  "services": {
    "frontend": {
      "root": "apps/glass-fortress/frontend",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}
