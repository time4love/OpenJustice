{
  "name": "openjustice",
  "version": "0.1.1",
  "private": true,
  "overrides": {
    "zod": "^4.4.3"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "workspaces": [
    "apps/glass-fortress/backend",
    "apps/glass-fortress/frontend",
    "apps/bronze-fortress/backend",
    "apps/bronze-fortress/frontend",
    "packages/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "gf:backend": "npm run dev --workspace=apps/glass-fortress/backend",
    "gf:frontend": "npm run dev --workspace=apps/glass-fortress/frontend",
    "bf:backend": "npm run dev --workspace=apps/bronze-fortress/backend",
    "bf:frontend": "npm run dev --workspace=apps/bronze-fortress/frontend",
    "test:gf": "npm run test --workspace=apps/glass-fortress/backend",
    "test:bf": "npm run test --workspace=apps/bronze-fortress/backend"
  }
}
