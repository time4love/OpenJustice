// Prisma schema for the Glass Fortress Dark Vault.
// PII is stored here only — never in Pinecone or any AI-accessible layer.
// Switch datasource to postgresql for production by updating DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Researcher identity — pseudonymous by design.
// supabaseUserId links to Supabase auth.users (holds email for magic link).
// We never sync email or real name here — handle is the only public identifier.
// ---------------------------------------------------------------------------

enum ResearcherRole {
  RESEARCHER // full write access including promote_evidence
  ADMIN // RESEARCHER + approve/revoke other researchers
}

// A vetted contributor with write access to the evidence vault.
// handle: self-chosen pseudonym (e.g. "watchdog_7", "חוקר_א") — only public identifier.
// mcpTokenHash: bcrypt hash of the per-user MCP bearer token (plaintext shown once on creation).
// approved: admin must explicitly approve before token works.
model Researcher {
  id             String         @id @default(cuid())
  supabaseUserId String         @unique // opaque UUID from Supabase auth — never expose in UI
  handle         String         @unique // self-chosen pseudonym — public display name
  role           ResearcherRole @default(RESEARCHER)
  mcpTokenHash   String? // bcrypt hash of bearer token; null until first token generation
  approved       Boolean        @default(false)
  createdAt      DateTime       @default(now())

  evidence           Evidence[]
  thesisVersions     ThesisVersion[]
  theses             Thesis[]            @relation("ThesisAuthor")
  publishedTheses    Thesis[]            @relation("ThesisPublisher")
  researchSessions   ResearchSession[]
  summaryCorrections SummaryCorrection[]
}

// ---------------------------------------------------------------------------
// Wayback Machine forensic scan entities.
//
// TrackedUrl       — primary entity: a URL being tracked for silent edits.
// WaybackScrapeJob — internal batch unit; multiple per TrackedUrl for paginated
//                    CDX scans. Chained server-side by runFullScan(), not exposed
//                    directly in the UI.
// ---------------------------------------------------------------------------

enum WaybackJobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

// Why a job ended FAILED — lets the frontend distinguish an outage on
// archive.org's end (retry later, nothing wrong with our pipeline) from an
// unexpected failure worth investigating.
enum WaybackFailureReason {
  WAYBACK_OFFLINE // every fetch in this batch hit HTTP 503 from web.archive.org
  ALL_FETCHES_FAILED // every fetch in this batch failed, but not via 503
}

enum TrackedUrlStatus {
  IDLE // created via legacy sync endpoint; no async status tracking
  SCANNING // runFullScan is active (or was interrupted — resumable)
  PAUSED // user paused mid-scan; resumable via POST /scan
  COMPLETED // all CDX batches processed
  FAILED // unrecoverable error during processing
}

// How a capture came into our possession — see docs/gf-factual-layer-rebuild-dev-plan.md §2.
//
// These are NOT three equal kinds of capture. Archiving IS the pipeline: a URL
// submission asks CDX what the Archive holds, and asks Save Page Now when it
// holds nothing. WAYBACK is therefore the normal case and the destination of
// every submission; DIRECT is a transient precursor that persists only where
// archiving is genuinely impossible.
//
// Only evidential standing differs. Diffs, trajectories, identity and
// boilerplate detection all work over the merged history without consulting
// this field.
enum CaptureProvenance {
  WAYBACK // the Archive holds it; a stranger can re-check it independently
  DIRECT // we fetched it and the Archive has not (yet) indexed it
  ASSERTED // text supplied to us; nobody we control observed the page
}

// Tracks a government/health URL submitted for Wayback Machine forensic analysis.
// Primary entity — navigate directly to this for version history and status.
// url is unique: one TrackedUrl per URL, reused across re-scans.
model TrackedUrl {
  id                     String                       @id @default(uuid())
  url                    String                       @unique
  title                  String?
  status                 TrackedUrlStatus             @default(IDLE)
  createdAt              DateTime                     @default(now())
  diffs                  UrlVersionDiff[]
  snapshots              UrlSnapshot[]
  job                    WaybackScrapeJob?
  trajectories           ClaimTrajectory[]
  trajectoryComputations ClaimTrajectoryComputation[]
  cdxIndexEntries        CdxIndexEntry[]
  cdxQueries             CdxQuery[]
}

// One record per unique archived snapshot of a TrackedUrl.
// fullText is stored locally — immune to Wayback Machine takedowns.
// contentHash (SHA-256 of fullText) can be registered on-chain for immutable chain of custody.
// Shared across diffs: two diffs spanning the same snapshot reference the same row.
model UrlSnapshot {
  id                      String            @id @default(cuid())
  trackedUrlId            String
  trackedUrl              TrackedUrl        @relation(fields: [trackedUrlId], references: [id], onDelete: Cascade)
  // How this capture came into our possession. See CaptureProvenance.
  //
  // Existing rows backfill to WAYBACK: every capture predating this column came
  // from WaybackScraper, which has no other source.
  provenance              CaptureProvenance
  // When the capture was TAKEN — not when we stored it (that is createdAt).
  //
  // Derived from waybackTimestamp for archived captures and from the fetch
  // moment otherwise. This is the field every chronological operation orders
  // by, so that a corpus mixing provenances still has one timeline.
  capturedAt              DateTime
  // The Archive's identifier, present only on archived captures.
  //
  // Nullable since a DIRECT or ASSERTED capture has none. The composite unique
  // below still holds: Postgres does not treat NULLs as colliding, so any
  // number of non-archived captures coexist under one TrackedUrl.
  waybackTimestamp        String? // YYYYMMDDHHMMSS — unique Wayback archive identifier
  snapshotDate            String // YYYY-MM-DD — human-readable date
  // Where this capture was fetched FROM — the Wayback canonical URL for an
  // archived capture, the live URL for a direct one.
  snapshotUrl             String
  fullText                String // Readability's article — NOT the page. See `text` and `document`.
  contentHash             String // SHA-256(fullText) — chain of custody, and the only hash anchored today
  // THE PAYLOAD AS FETCHED. Bytes, not text, and nothing derived from it.
  //
  // This column exists because the first attempt at Level 1 REPRODUCED THE BUG IT
  // WAS FIXING, at a lower loss rate. The plan diagnosed Readability as
  // discarding at write time and prescribed storing the document; the
  // implementation stored `normaliseText(htmlToText(html))` and named it the
  // document. `NOT NULL` then enforced that SOMETHING was present, not that it
  // was the document — a constraint standing in for a guarantee, inside the level
  // built to remove exactly that.
  //
  // The concrete cost was not abstract: htmlToText discards hrefs while keeping
  // anchor text, and this platform's central finding is that a REPORTING-CHANNEL
  // LINK was removed. Two different links with the same visible text were, to us,
  // the same page. Measured on staging 2026-08-27: CDX rows 6, 7 and 8 of the
  // tracked page carry two distinct payload digests and collapsed to ONE stored
  // hash, so recovering row 8 returned UNCHANGED and wrote nothing.
  //
  // Bytes rather than a decoded string, deliberately: you can derive text from
  // bytes and never bytes from text, so this preserves every FUTURE definition of
  // "changed" instead of committing now, irreversibly, to one.
  //
  // NOT NULL since 20260827180000_snapshot_document_bytes_required, applied only
  // after `forensics:backfill-document-bytes` had filled every row — the bytes
  // cannot be derived in SQL from anything already stored, which is why it took
  // two migrations. An environment that has not been backfilled fails that
  // migration and aborts its deploy with the previous version still serving.
  document                Bytes
  // SHA-256 of `document`. Integrity, and where the anchor moves at Level 3.
  documentHash            String
  // The Content-Type header verbatim, so the bytes can be decoded later.
  //
  // Storing bytes without the charset that interprets them would re-create the
  // loss this column exists to end. Nullable only because a capture stored before
  // this column cannot invent one.
  documentContentType     String?
  // The content-coding applied to the stored bytes, NORMALISED: `identity`
  // where the response declared none, NULL where we never observed the headers.
  //
  // `document` holds the bytes AS SERVED — gzipped where the source served
  // gzip — so this is what says how to read them. Without it the payload is
  // uninterpretable, exactly as it is without the charset.
  //
  // The rule this instance establishes: store every response header without
  // which the bytes cannot be interpreted. Today that is Content-Type and
  // Content-Encoding; anything else is optional, and those two are part of the
  // payload's meaning rather than metadata about it.
  //
  // Null is a real signal rather than a shrug: a row fetched by the original
  // backfill has a documentHash and no encoding; one fetched by the current code
  // has both. So null means "fetched by code that did not record it, or never
  // fetched" — never "the source declared nothing", which is `identity`.
  documentContentEncoding String?
  // Normalised plain text derived from `document` — a CACHED DERIVATION, not a
  // source of truth. Renamed from `rawText`, which claimed to be the document.
  //
  // Cached rather than recomputed per read because diffs and trajectories read it
  // constantly, and §3 rules that an expensive function of held data is a cached
  // verdict invalidated by version — hence textExtractionVersion below.
  text                    String
  // SHA-256(text). THE NOVELTY AND DIFFING KEY.
  //
  // Novelty is keyed here rather than on the payload deliberately. Byte-identity
  // is too sensitive: a rotating cache-buster or a timestamp in a comment would
  // make every capture distinct and store hundreds of near-identical documents.
  // Nothing is discarded either way — the payload is kept whole — so the
  // sensitivity question is answered explicitly here instead of being decided by
  // accident inside an extractor.
  textHash                String
  // Which derivation produced `text`. Change it and every cached text is stale.
  //
  // Built now rather than invented after the fact, which this repository has now
  // done four times (classifierVersion, summaryVersion, diffInputVersion,
  // DETECTION_VERSION).
  textExtractionVersion   String
  onChainTxHash           String? // Blockchain tx hash once contentHash is registered on-chain
  createdAt               DateTime          @default(now())

  beforeDiffs    UrlVersionDiff[] @relation("BeforeSnapshot")
  afterDiffs     UrlVersionDiff[] @relation("AfterSnapshot")
  // The index entry this capture was made from, when it came from the Archive.
  //
  // Deliberately NOT a `cdxDigest` column on this table. Two hash-shaped columns
  // of different provenance in one row is an invitation, and this repository has
  // already paid for it: a base32 SHA-1 was written into `documentHash`, a
  // SHA-256 column, and stayed there across both environments. The digest lives
  // on CdxIndexEntry, one join away, where nothing can mistake it for ours.
  cdxIndexEntry  CdxIndexEntry?   @relation("CdxEntryCapture")
  /// Index entries whose UNCHANGED verdict was computed against this capture.
  cdxComparisons CdxIndexEntry[]  @relation("CdxEntryComparedTo")

  @@unique([trackedUrlId, waybackTimestamp])
  // A TrackedUrl cannot hold two captures of the same instant. This is the
  // constraint that makes capturedAt a usable timeline key across provenances,
  // where waybackTimestamp only ever constrained archived ones.
  @@unique([trackedUrlId, capturedAt])
}

// Internal scan-state record. One per TrackedUrl — updated in-place across
// CDX batch iterations rather than creating new records per batch.
model WaybackScrapeJob {
  id                 String                @id @default(uuid())
  url                String
  status             WaybackJobStatus      @default(PENDING)
  totalSnapshots     Int                   @default(0)
  processedSnapshots Int                   @default(0)
  // Set only when status is FAILED — null for every other status.
  failureReason      WaybackFailureReason?
  // JSON: Array<{ timestamp: string; digest: string; status: 'PENDING' | 'DONE' | 'FAILED' }>
  snapshotsList      String                @default("[]")
  trackedUrlId       String                @unique
  trackedUrl         TrackedUrl            @relation(fields: [trackedUrlId], references: [id], onDelete: Cascade)
  fromDate           String? // YYYYMMDD — CDX query start date for the current batch
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
}

// Records a single detected change between two consecutive archived snapshots of a TrackedUrl.
// A row is created for every processed snapshot pair, not only legally significant ones —
// isLegallySignificant just marks which are AI-flagged; see ForensicAgent.deriveSignificance.
model UrlVersionDiff {
  id                      String              @id @default(uuid())
  trackedUrlId            String
  trackedUrl              TrackedUrl          @relation(fields: [trackedUrlId], references: [id])
  beforeDate              String
  afterDate               String
  snapshotUrl             String
  deletedText             String              @default("[]") // JSON array of AI-extracted claim strings (Hebrew summaries)
  addedText               String              @default("[]") // JSON array of AI-extracted claim strings (Hebrew summaries)
  rawDeletedText          String              @default("[]") // JSON array of raw page text chunks that were removed
  rawAddedText            String              @default("[]") // JSON array of raw page text chunks that were added
  aiSignificance          String              @default("") // Hebrew forensic explanation
  isLegallySignificant    Boolean             @default(false)
  // Which classifier produced the classification on this row.
  //
  // Stored LLM-derived columns drift the moment the prompt changes: without
  // provenance, isLegallySignificant silently means different things on
  // different rows depending on when they were scanned, and nothing can tell a
  // stale row from a fresh one. classifierVersion is the human-readable
  // targeting key ("reclassify everything below v2"); classifierPromptHash is
  // the proof, since a version string is a promise and a hash is checkable — if
  // the prompt at that version does not hash to this value, something else
  // judged this row. Null on rows classified before provenance was recorded.
  classifierVersion       String?
  // Provenance for the SUMMARY alone, which moves independently of the
  // classification. `forensics:resummarize` rewrites aiSignificance from the
  // already-extracted items and does NOT re-extract, so the items stay at
  // whatever classifierVersion produced them while the prose becomes
  // self-contained. Stamping classifierVersion in that case would claim the
  // items had been re-judged, which they have not.
  //
  // null means the summary predates the self-contained rule — written under a
  // prompt that instructed cross-referencing other evidence records inside it.
  summaryVersion          String?
  // Which INPUT RULE produced this row's raw chunks — a third provenance axis,
  // separate from classifierVersion and summaryVersion because all three move
  // independently and one string covering them would have to lie about two.
  //
  // classifierPromptHash cannot see this: the prompt is byte-identical across the
  // change it records. What differs is what was FED to that prompt. A row written
  // under the old rule holds at most 8 chunks per side (longest-first, the rest
  // discarded before the write) and was classified over only those ≥ 40 chars.
  // Measured: 159 of 290 detected changes never reached the database at all.
  //
  // null means the row predates input provenance — i.e. it was computed under the
  // truncating rule and its raw chunks are UNDERSTATED. Not a cosmetic gap: such a
  // row cannot be brought up to date by reclassification, only by recomputing the
  // diff from its snapshots. See docs/gf-diff-truncation-dev-plan.md.
  diffInputVersion        String?
  // Which MODEL produced the classification, as `provider:model`.
  //
  // The fourth provenance axis, and the one nothing else can express:
  // classifierVersion names the procedure and classifierPromptHash proves the
  // prompt TEXT, so a row judged by gemini-flash and a row judged by
  // claude-sonnet carry byte-identical provenance. The provider is chosen by an
  // env var (<AGENT>_PROVIDER) that can change between two runs of the same
  // commit, so a corpus can become mixed with nothing in the data to show it.
  //
  // null means the row predates model provenance.
  classifierModel         String?
  // How many draws the classifier took before the best-covering one was kept.
  //
  // Stored because it is the one thing about a classification that CANNOT be
  // derived afterwards. Coverage itself is derived on read from the raw chunks
  // and the items — that way it answers for rows written long before the check
  // existed, and cannot go stale. The draw count is process, not product: no
  // amount of reading the row recovers whether it was a first draw or the best of
  // three.
  //
  // null means the row predates best-of-N, i.e. it is a single draw stored as
  // though it were a measurement.
  classifierDraws         Int?
  classifierPromptHash    String?
  // ForensicAgent classification. Stored on the diff (not only on the promoted
  // Evidence) because a researcher may promote a diff manually via
  // /forensics/promote, and that path needs the classification without re-running
  // the agent. isLegallySignificant is derived from this being non-empty.
  investigativeCategories String[]            @default([])
  debates                 DiffDebateSession[]
  beforeSnapshotId        String? // FK to the UrlSnapshot for the "before" state
  beforeSnapshot          UrlSnapshot?        @relation("BeforeSnapshot", fields: [beforeSnapshotId], references: [id])
  afterSnapshotId         String? // FK to the UrlSnapshot for the "after" state
  afterSnapshot           UrlSnapshot?        @relation("AfterSnapshot", fields: [afterSnapshotId], references: [id])
  createdAt               DateTime            @default(now())
  evidence                Evidence[]
  summaryCorrections      SummaryCorrection[]
}

// Mirrors the pgvector table created via raw SQL in the baseline migration
// (20260815000000) — see VectorStoreService, which is the only code that
// touches it, always through raw SQL, never Prisma Client. `embedding` uses
// Unsupported() because Prisma has no native vector type.
//
// This model exists ONLY so `prisma migrate diff`/`migrate dev` stop seeing
// this table as unmodeled drift and proposing to drop it. Cherry-picked
// (manually, due to uncommitted local changes blocking a real cherry-pick)
// from `fix/gf-evidence-embeddings-schema-drift` (2de874b), an already-
// reviewed and merged-elsewhere fix this branch hadn't picked up yet — not
// reinvented. Do not add relations to this model or query it via Prisma
// Client — `embedding`'s Unsupported() type cannot be selected, and the
// `match_evidence()` SQL function it backs is not representable here at all.
model EvidenceEmbedding {
  id        String                      @id
  content   String
  embedding Unsupported("vector(3072)")

  @@map("evidence_embeddings")
}

// A named public figure (official, politician, senior doctor, journalist) extracted
// from evidence by the AI. Normalized here so every mention of the same person
// across all evidence records links to a single canonical entity.
model KeyFigure {
  id        String     @id @default(cuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  evidence  Evidence[]
}

model Whistleblower {
  id               String   @id @default(uuid())
  fileHash         String   @unique
  encryptedContact String
  consentGiven     Boolean
  createdAt        DateTime @default(now())
}

// Public evidence registry — structured metadata for stats and timeline queries.
// Pinecone stores ONLY the embedding + fileHash; all queryable fields live here.
// Linked to Whistleblower only by fileHash — never joined directly.
enum EvidenceStatus {
  // Created via an MCP write tool, or auto-promoted while on-chain registration
  // was unavailable/failed — awaits human review + registration (onChainTxHash is null).
  PENDING_REVIEW
  CONFIRMED // Registered on-chain (onChainTxHash set) and indexed in Pinecone
}

enum EvidenceType {
  DOCUMENT // File upload or URL submission
  FORENSIC_DIFF // Auto-promoted from UrlVersionDiff (isLegallySignificant=true)
}

model Evidence {
  id                       String                @id @default(uuid())
  fileHash                 String                @unique
  // Fails closed, not open: a create() that forgets to set this explicitly
  // becomes PENDING_REVIEW, never a silent false claim of on-chain registration.
  // See onChainTxHash — CONFIRMED must only ever be set alongside a real tx hash.
  status                   EvidenceStatus        @default(PENDING_REVIEW)
  onChainTxHash            String? // Blockchain tx hash once fileHash is registered on-chain — mirrors UrlSnapshot.onChainTxHash
  // The identity this record carried before the evidence hash moved to being
  // derived from its two archived snapshots, and the anchor registered under it.
  //
  // Kept rather than discarded because that anchor is a real, permanent
  // transaction that now matches nothing derivable — precisely the
  // ORPHANED_ANCHOR condition check_on_chain_status exists to flag. Recording it
  // here says the orphan was created deliberately, by a known migration, instead
  // of leaving a future audit to find an unexplained one and reasonably conclude
  // the vault had been tampered with.
  //
  // Null on every record created after the change, which is the normal state.
  previousFileHash         String?
  previousOnChainTxHash    String?
  evidenceType             EvidenceType          @default(DOCUMENT)
  evidenceRole             String                @default("Incriminating")
  // The evidence's classification — see src/lib/investigativeCategories.ts.
  // Intrinsic to the evidence and fixed at creation; deliberately NOT a link to
  // Thesis, since evidence normally predates the theses that cite it and one
  // record may support several.
  //
  // This is the ONLY classification axis. A coarser `category` field was removed:
  // it restated this at lower resolution and could contradict it.
  investigativeCategories  String[]              @default([])
  // What the intake model SAID this document is about. Freeform by design: it is
  // an observation about the document, and re-running intake to tidy it would
  // re-roll tier, date, figures and summary too.
  targetEntity             String
  // The KEY. Resolved from `targetEntity` by a deterministic lookup — no model —
  // in lib/targetEntity.
  //
  // These were one field, doing two incompatible jobs: display label and
  // exact-match filter key, with nothing pinning the form. One prompt produced
  // "Ministry of Health" and "משרד הבריאות" for the same body, so
  // `?targetEntity=` returned half the evidence under each spelling with no
  // indication the other half existed. Seven more records named
  // `corona.health.gov.il`, which is a source rather than an entity at all.
  //
  // Null means NOT YET RESOLVED — a gap in the vocabulary to fix, never
  // "unknown entity". Same discipline as an absent EvidenceCapture.
  canonicalTargetEntity    String?
  evidenceTier             String
  evidencePerspective      String?
  tierReasoning            String?
  summary                  String
  evidenceDate             String
  figures                  KeyFigure[]
  medicalConditions        String
  statisticalClaims        String                @default("[]")
  regulatoryMentions       String                @default("[]")
  euaOmissionStatus        String                @default("Not Applicable")
  sourceUrl                String?
  fileUrl                  String?
  // Screenshot 2..N when this evidence was recovered from a page that needed
  // multiple captures (e.g. a blocked/unfetchable URL too long for one
  // screenshot). fileUrl always holds the first/primary capture; this array
  // holds the rest, in the same reading order they were submitted in — the
  // combined set is treated as one document, analyzed together, not as
  // separate pieces of evidence. Empty for every ordinary single-file record.
  additionalScreenshotUrls String[]              @default([])
  ipfsCid                  String? // IPFS CID of the encrypted evidence blob (null if not yet anchored)
  // @unique enforces the true 1:1 with UrlVersionDiff at the DB level — previously
  // only an application-level check in POST /forensics/promote prevented a diff
  // from being promoted to more than one Evidence row.
  urlVersionDiffId         String?               @unique
  urlVersionDiff           UrlVersionDiff?       @relation(fields: [urlVersionDiffId], references: [id])
  // Present only for evidence a researcher argued into existence over the
  // forensic classifier's judgment — the full debate that justified it.
  debateSession            DiffDebateSession?
  gapResolutions           ThesisGapResolution[]
  // Which intake rubric produced this record's classification.
  //
  // evidenceTier, evidenceRole, investigativeCategories, summary, evidenceDate
  // and the figures relation are all LLM output, written once and never
  // recomputed. When the rubric changes they mean different things on different
  // rows — the same article classified either side of the 2026-08-25 change gave
  // Tier 3 with four figures and Tier 1 with two, and both rows would have looked
  // equally authoritative. Mirrors UrlVersionDiff.classifierVersion.
  //
  // Null on every record created before this existed. That reads as "unknown",
  // never as "current" — the same discipline as an absent EvidenceCapture.
  //
  // One known imprecision, recorded rather than hidden: POST /confirm receives an
  // `analysis` the client obtained from an earlier /intake call, so if those two
  // requests straddle a deploy the stamp names the prompt live at confirm time
  // rather than the one that judged it. A narrow window, and still far better
  // than no stamp at all.
  intakeVersion            String?
  // SHA-256 of the system prompt actually sent to the model. The version string
  // is a promise; this is the proof, checkable against git.
  intakePromptHash         String?
  createdById              String? // Researcher.id — null for legacy records
  createdBy                Researcher?           @relation(fields: [createdById], references: [id])
  // The stored document this record's fileHash was computed over. Absent on
  // every record created before captures existed, and on paths that do not
  // produce one — absence means "cannot be checked", never "does not match".
  capture                  EvidenceCapture?
  createdAt                DateTime              @default(now())
}

/// The exact text an Evidence.fileHash was computed from, kept so the identity
/// can be recomputed from the database alone.
///
/// FINDING 79: article evidence hashed a LIVE fetch and stored nothing, so a page
/// carrying a view counter produced a new identity on every call and the record
/// could be re-derived from nothing at all. Storing the capture is what makes
/// "does this hash still hold?" answerable years later, against an artifact
/// rather than against a page that has since moved.
///
/// Separate table rather than a column on Evidence on purpose: the text runs to
/// tens of kilobytes, and Prisma selects every scalar by default, so a column
/// would put the whole document into every evidence list query.
model EvidenceCapture {
  id         String   @id @default(cuid())
  evidenceId String   @unique
  evidence   Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  /// The address the capture was taken from — part of the hashed payload, so it
  /// is stored here rather than read back off Evidence, which is nullable.
  sourceUrl  String
  /// Which extraction produced `text`. Recorded per capture, so a later change
  /// of extractor leaves old hashes explainable rather than merely superseded.
  extractor  String
  /// Exactly what was extracted. The identity covers its first HASHED_PREFIX_CHARS
  /// characters; the remainder is stored so nothing captured is thrown away.
  text       String
  /// The fetched document itself, so ANY extraction can be re-derived later.
  ///
  /// Hashing and analysis want opposite things from a page. Hashing wants the
  /// narrowest stable text — page furniture like a view counter must not reach
  /// it. Analysis wants the widest text, because a fact the model is not shown
  /// is a fact it will either miss or invent: the first production record got a
  /// wrong `evidenceDate` because Readability discards the byline as chrome, and
  /// the model filled the gap rather than reporting the absence.
  ///
  /// Storing the source is what lets both be served from one captured artifact
  /// without either becoming unverifiable. It is also the lesson from
  /// UrlSnapshot.fullText, where keeping only the extraction is exactly why the
  /// discarded third of each page can never be recovered.
  ///
  /// Null on captures taken before this was stored, and on the website's
  /// submission route, where the text arrives from the client and the server
  /// never holds the document.
  html       String?
  /// When the source was fetched — NOT when the row was written.
  capturedAt DateTime
  createdAt  DateTime @default(now())
}

enum ThesisVersionStatus {
  PENDING_AI // AI devil's advocate analysis not yet complete
  COMPLETE // aiAnalysis populated, ready to display
}

enum MentionType {
  KEY_FIGURE // @name — references a KeyFigure.name
  EVIDENCE // #ev_ — references an Evidence.fileHash
  TRACKED_URL // #url_ — references a TrackedUrl.id
  // A ClaimTrajectory.id, NOT a claimHash. The id pins the detection pass, so a
  // cited trajectory keeps resolving to what was cited; claimHash follows the
  // claim across recomputations and would let "removed and never restored"
  // become silently false when a later scan finds the claim back.
  CLAIM_TRAJECTORY
}

// A crowdsourced legal thesis — wiki-style versioned narrative that anchors
// claims to evidence via @keyFigure and #evidence mentions.
// headVersionId points to the canonical (latest-wins) version.
model Thesis {
  id            String            @id @default(cuid())
  title         String?
  headVersionId String?           @unique
  headVersion   ThesisVersion?    @relation("ThesisHead", fields: [headVersionId], references: [id])
  versions      ThesisVersion[]   @relation("ThesisVersions")
  sessions      ResearchSession[]
  createdById   String? // Researcher.id — null for legacy records
  createdBy     Researcher?       @relation("ThesisAuthor", fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())

  // Publication is a PINNED VERSION, not a flag and not a consequence of analysis.
  //
  // null ⇒ DRAFT: visible to approved researchers only. Set ⇒ the public sees
  // exactly this version, and ONLY this version, until a researcher publishes
  // again. Editing the head and re-running the Devil's Advocate changes nothing
  // public. With a boolean flag the public would silently follow every later
  // edit, so a researcher publishes one text and the public reads another.
  // Unpublishing sets the pin back to null and deletes nothing.
  // Preconditions: services/thesisPublication.ts.
  publishedVersionId      String?        @unique
  publishedVersion        ThesisVersion? @relation("ThesisPublished", fields: [publishedVersionId], references: [id])
  publishedAt             DateTime?
  publishedById           String? // Researcher.id of whoever published
  publishedBy             Researcher?    @relation("ThesisPublisher", fields: [publishedById], references: [id])
  // The public-interest anchor (COMPLIANCE.md Rule 5) as a dedicated field rather
  // than free text in the body: structurally guaranteed to exist on a published
  // thesis and rendered consistently on every thesis and call page.
  publicInterestStatement String?
}

// One row per edit. userContent is TipTap JSON; aiAnalysis is devil's advocate output.
// contentHash = SHA-256(userContent + aiAnalysis) for tamper evidence.
model ThesisVersion {
  id                String                @id @default(cuid())
  thesisId          String
  thesis            Thesis                @relation("ThesisVersions", fields: [thesisId], references: [id], onDelete: Cascade)
  parentVersionId   String?
  parentVersion     ThesisVersion?        @relation("VersionTree", fields: [parentVersionId], references: [id])
  childVersions     ThesisVersion[]       @relation("VersionTree")
  userContent       Json // TipTap document JSON
  aiAnalysis        Json? // DevilsAdvocateAgent output, null until COMPLETE
  // SHA-256 of the EXACT message array sent to the critic — thesis text as it was
  // serialised, evidence block, resolved gaps, rendered trajectory block, summary
  // caveat and the system prompt. Null on every version analysed before this
  // existed, which reads as "unknown, so not proven current" and re-runs.
  //
  // contentHash below hashes the OUTPUT, for publication pinning, and can say
  // nothing about whether the analysis still answers the facts. Status could not
  // either: PENDING_AI is set only when a version is CREATED, so a critique
  // survived its evidence summaries being corrected, a new detection pass, and
  // two changes to what the critic is given — while check 2 kept passing.
  analysisInputHash String?
  contentHash       String // SHA-256 of userContent + aiAnalysis
  status            ThesisVersionStatus   @default(PENDING_AI)
  mentions          ThesisMention[]
  gapResolutions    ThesisGapResolution[]
  isHead            Thesis?               @relation("ThesisHead")
  isPublished       Thesis?               @relation("ThesisPublished")
  createdById       String? // Researcher.id — null for legacy records
  createdBy         Researcher?           @relation(fields: [createdById], references: [id])
  createdAt         DateTime              @default(now())
}

// Records which AI-identified evidence gap has been addressed by a specific evidence record.
// Linked to a specific ThesisVersion so resolutions are version-scoped.
// On next AI analysis, resolutions are passed as context so DevilsAdvocate can assess whether the gap is truly closed.
model ThesisGapResolution {
  id              String        @id @default(cuid())
  thesisVersionId String
  thesisVersion   ThesisVersion @relation(fields: [thesisVersionId], references: [id], onDelete: Cascade)
  gapIndex        Int // index into aiAnalysis.evidenceGaps[]
  evidenceId      String // Evidence.fileHash
  evidence        Evidence      @relation(fields: [evidenceId], references: [fileHash])
  createdAt       DateTime      @default(now())

  @@unique([thesisVersionId, gapIndex])
}

// Extracted first-class references from ThesisVersion.userContent nodes.
// Queryable index — avoids parsing JSON at query time.
model ThesisMention {
  id              String        @id @default(cuid())
  thesisVersionId String
  thesisVersion   ThesisVersion @relation(fields: [thesisVersionId], references: [id], onDelete: Cascade)
  type            MentionType
  refId           String // KeyFigure.name | Evidence.fileHash | TrackedUrl.id | ClaimTrajectory.id
}

// ---------------------------------------------------------------------------
// Research Sessions
// ---------------------------------------------------------------------------

enum ResearchSessionStatus {
  ACTIVE
  CLOSED
}

enum ResearchSessionEventType {
  SESSION_STARTED // logged automatically on session creation
  VERSION_CREATED // logged automatically when a thesis version is created
  GAP_RESOLVED // logged automatically when a gap resolution is saved
  AI_ANALYSIS_RUN // logged automatically when AI analysis completes
  NOTE // logged manually via add_session_note MCP tool
  SESSION_CLOSED // logged automatically on session close
  // Deciding WHAT the thesis should argue, before one exists.
  FRAMING_PROPOSED // a researcher's proposed framing of the question
  FRAMING_ASSESSED // the adversarial response to it
  THESIS_ATTACHED // the framing produced a thesis; refId is the Thesis id
  // Publication is a deliberate, gated act and belongs in the record of the
  // session that did it. refId is the ThesisVersion id that was pinned/unpinned.
  PUBLICATION_RATIONALE // the researcher's argued case for publishing
  PUBLICATION_ASSESSED // the assessor's response to it; description is the assessment JSON
  THESIS_PUBLISHED
  THESIS_UNPUBLISHED
  // Written onto a session that ANOTHER researcher closed to open their own,
  // naming who closed it and why, so its owner returns to a record rather than a guess.
  SESSION_CLOSED_BY_OTHER
}

// A named Claude+human research sprint on a thesis.
// Only one ACTIVE session per thesis at a time; creating a new one auto-closes the previous.
model ResearchSession {
  id String @id @default(cuid())

  // Nullable so a session can open on a QUESTION before any thesis exists.
  //
  // Deciding what a thesis should argue is the most consequential step in the
  // workflow — the topic string determines which evidence is pulled semantically
  // and what the Devil's Advocate attacks, and a wrong framing produces a
  // well-argued thesis about the wrong thing that no later iteration rescues.
  // Until 2026-08-22 that decision happened entirely outside the system:
  // suggest_thesis interpolated its `topic` into a prompt and discarded it, and
  // a session could not exist without a thesisId, so the conversation that chose
  // the framing left no trace anywhere.
  //
  // Deliberately NOT a third session type. ResearchSession and DiffDebateSession
  // already exist; a third would be a smell. A framing session IS a research
  // session — it just starts before its subject does, and the thesis attaches to
  // it when created.
  thesisId     String?
  thesis       Thesis?               @relation(fields: [thesisId], references: [id], onDelete: Cascade)
  // The question the session opened on, when it opened before a thesis.
  question     String?
  name         String
  status       ResearchSessionStatus @default(ACTIVE)
  // Who opened it. Still nullable, and deliberately so: two staging sessions
  // predate ownership, and assigning them a researcher would put a name on work
  // nobody can attribute — falsifying provenance on a platform whose premise is
  // that custody is verifiable. They read as legacy, the same pattern as
  // Evidence.createdById.
  //
  // A session with no owner belongs to NOBODY, not to everyone. That was the
  // opposite before 2026-08-25, when exclusivity was global and a null owner
  // therefore matched every caller.
  //
  // Opening a session now REQUIRES a researcher, so no new row can be ownerless.
  researcherId String?
  researcher   Researcher?           @relation(fields: [researcherId], references: [id])

  // ---------------------------------------------------------------------
  // ⚠️  TWO CONSTRAINTS EXIST ON THIS TABLE THAT PRISMA CANNOT SHOW YOU.
  //
  //   ResearchSession_one_active_per_researcher  UNIQUE (researcherId) WHERE status = 'ACTIVE'
  //   ResearchSession_one_active_per_thesis      UNIQUE (thesisId)     WHERE status = 'ACTIVE'
  //
  // Declared in migrations/20260825190000_session_active_locks. They enforce
  // "one ACTIVE session per researcher, and one per thesis" — uniqueness over a
  // SUBSET of rows, which is exactly what a partial index is for. The row itself
  // is never deleted on close: a publication attaches to the session that
  // performed it and its events hang off it, so it is the audit trail rather
  // than a lock.
  //
  // `@@index` in Prisma 5.22 rejects a `where:` argument ("No such argument"),
  // so these can only be raw SQL. VERIFIED against live staging 2026-08-25:
  // Prisma does not see a partial index at all — db:check-drift still reported
  // "No difference detected" with one present, and a generated migration did not
  // propose dropping it. Invisible, not endangered. (An earlier design added two
  // nullable @unique columns to emulate this; it was abandoned once the drift
  // assumption behind it was tested and turned out to be false.)
  //
  // Because they are invisible they cannot be assumed. Two consequences:
  //   1. Inserting a second ACTIVE session raises Prisma error P2002. That is
  //      the constraint working — translate it into a named refusal, never a 500.
  //   2. A Prisma version that DOES understand partial indexes would start
  //      reporting them as drift. Re-check after any major upgrade.
  //
  // thesisId is NULL for a framing session, which opens before its thesis
  // exists. Postgres treats NULLs as DISTINCT in a unique index, so several
  // researchers may frame concurrently while no two can hold the same thesis —
  // that falls out rather than needing a special case.
  // ---------------------------------------------------------------------

  events    ResearchSessionEvent[]
  createdAt DateTime               @default(now())
  closedAt  DateTime?
}

// One event per significant action that occurred during a session.
model ResearchSessionEvent {
  id          String                   @id @default(cuid())
  sessionId   String
  session     ResearchSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type        ResearchSessionEventType
  description String
  refId       String? // ThesisVersion.id | Evidence.fileHash | ThesisGapResolution.id
  createdAt   DateTime                 @default(now())
}

// ---------------------------------------------------------------------------
// MCP OAuth 2.1 storage (docs/gf-mcp-oauth-dev-plan.md, Phase 1).
//
// Generic key-value store for the `oidc-provider` library's Adapter interface —
// oidc-provider itself defines the "model kinds" (Client, Grant, AuthorizationCode,
// AccessToken, RefreshToken, Session, Interaction, ...) and expects one uniform
// upsert/find/consume/destroy interface across all of them, not a bespoke table per
// kind. One table, keyed by (modelName, id), is the correct shape for that adapter —
// see PrismaOidcAdapter (src/oauth/prismaOidcAdapter.ts) for how each field is used.
//
// accountId carries our Researcher.id for every model kind that represents a grant of
// access (Grant, AccessToken, RefreshToken, Session) — indexed so the profile page's
// "connected apps" revoke UI (Phase 3) can list a researcher's active grants without
// querying into the opaque `payload` JSON.
// ---------------------------------------------------------------------------

model OidcModel {
  modelName  String // oidc-provider's model kind, e.g. "Client", "Grant", "AccessToken"
  id         String // oidc-provider-generated id, unique only within its modelName
  payload    Json // the full model payload, as oidc-provider hands it to Adapter#upsert
  grantId    String? // set when this model kind is tied to a Grant (tokens, codes)
  userCode   String? // device-flow user code — unused today, kept for adapter-interface completeness
  uid        String? // Session/Interaction lookup key — distinct from `id`
  accountId  String? // Researcher.id — set for Grant/AccessToken/RefreshToken/Session rows
  expiresAt  DateTime?
  consumedAt DateTime?

  @@id([modelName, id])
  @@unique([modelName, userCode])
  @@unique([modelName, uid])
  @@index([modelName, grantId])
  @@index([modelName, accountId])
}

// ---------------------------------------------------------------------------
// Public adverse-outcome self-reports.
//
// Deliberately NOT a form of Evidence. Evidence is low-volume, individually
// citable, and traceable to a checkable artifact (see investigativeCategories
// and Evidence.status above). Reports are the opposite shape: high-volume,
// individually unverifiable, and valuable only as an aggregate pattern — a
// thesis may cite "347 reports of X within window Y," never a single Report
// row. Keeping them a separate model makes that distinction structural, not
// a status flag someone can forget to check.
//
// Mirrors Bronze Fortress's Evidence/structured-intake split: Report is the
// thin envelope (dedup, reporter contact); the two domain tables below hold
// the actual structured answers. A Report points DOWN to exactly one of
// them — never the reverse — so the intake tables stay free of
// report-envelope concerns.
//
// No status field, deliberately — see
// docs/gf-adverse-event-report-schema-dev-plan.md §2.10. There is no
// per-report human gate a status would represent: a report counts toward
// the aggregate the moment it's created, having already cleared every check
// that matters (verified email, explicit consent, schema validation). A
// report later confirmed to be spam/fraudulent is deleted, not marked —
// there's no reason to keep a row around whose only purpose was to be
// excluded from every query that reads this table. User-driven design
// review, 2026-08-20 — followed directly from questioning why a moderation
// queue (and, before that, PlausibilityFlagReason/FLAGGED_IMPLAUSIBLE, see
// MedicalSymptomCategory's and MedicalCareEngagement's own comments)
// existed at all.
// ---------------------------------------------------------------------------

enum ReportDomain {
  MEDICAL // adverse health outcome
  SOCIAL_ECONOMIC // employment, access, or relationship consequence
}

// Shared by both domain tables so a bucket boundary is defined once — same
// reason investigativeCategories.ts is one file shared by two agents.
// Real timestamps are never public; only the bucket is. Mirrors BF's
// date-fuzzing principle (real dates private, quarter/year public).
enum ReportTimingWindow {
  WITHIN_24H
  WITHIN_1_WEEK
  WITHIN_1_MONTH
  WITHIN_6_MONTHS
  OVER_6_MONTHS
  UNKNOWN
}

// ~15-year bands past 18 — coarse enough to function as real k-anonymity
// protection in a small aggregate cell, fine enough to preserve an
// age-skewed signal (see the comment on Report.reporterAgeRange).
enum ReporterAgeRange {
  UNDER_18
  AGE_18_29
  AGE_30_44
  AGE_45_59
  AGE_60_74
  AGE_75_PLUS
  UNKNOWN
}

enum ReporterGender {
  FEMALE
  MALE
  OTHER
  UNKNOWN
}

model Report {
  id     String       @id @default(cuid())
  domain ReportDomain // denormalized off the two FKs below — lets filters/counts skip a join

  // Discriminated union — exactly one of these two is set, enforced at the
  // application layer (Prisma has no CHECK-constraint escape hatch here).
  medicalReportId String?                    @unique
  medicalReport   MedicalAdverseEventReport? @relation(fields: [medicalReportId], references: [id])

  socialEconomicReportId String?                     @unique
  socialEconomicReport   SocialEconomicImpactReport? @relation(fields: [socialEconomicReportId], references: [id])

  // Explicit, specific consent to processing special-category data (health;
  // for SocialEconomic reports, potentially religious-belief data via
  // FormalBasisAsserted) — GDPR Art. 9(2)(a) requires this to be explicit,
  // not inferred from clicking submit. Mirrors Whistleblower.consentGiven.
  // The intake endpoint must reject any submission where this is not true —
  // never default it, never infer it.
  consentGiven Boolean

  // Bucketed demographic context — standard pharmacovigilance stratification
  // variables (VAERS/EudraVigilance both track age band and sex; the
  // myocarditis-post-mRNA-vaccine signal was first detected specifically as
  // elevated in young males, an age+sex-stratified finding a flat aggregate
  // would have missed). Bucketed, not exact age/DOB, for the same reason
  // ReportTimingWindow buckets timing instead of storing a precise
  // timestamp — a quasi-identifier alone, but one that narrows the
  // anonymity set when combined with a rare category or a small aggregate
  // cell, so Phase 9's minimum-count suppression threshold (not yet built)
  // applies to these fields specifically, not just to the fingerprint
  // question these fields have nothing to do with.
  reporterAgeRange ReporterAgeRange @default(UNKNOWN)
  reporterGender   ReporterGender   @default(UNKNOWN)

  // Deliberately NO field derived from the reporter's email or identity —
  // not a hash, not a fingerprint, nothing. This was reconsidered mid-design
  // (see docs/gf-adverse-event-report-schema-dev-plan.md §2.8): a
  // deterministic hash of a verified email is pseudonymization, not
  // anonymization, under GDPR — the controller holding the salt can always
  // test a candidate email against it later. A hash designed to be
  // untestable is functionally identical to storing nothing, just with
  // extra bytes, so the honest design is to store nothing. This sacrifices
  // cross-report dedup by design — judged an acceptable trade-off given
  // per-submission live email verification is already a real barrier to
  // trivial spam, and ordinary rate limiting (generalLimiter in server.ts)
  // still applies. The corollary: a reporter can never prove a specific
  // report is theirs later (e.g. to request its deletion) — true anonymity
  // and self-service retraction of one report are mutually exclusive here.
  //
  // Deliberately no onChainTxHash either — individual reports are not
  // on-chain-anchored (discussed: volume + privacy + no individual
  // evidentiary claim). If aggregate integrity ever needs a tamper-evident
  // anchor, that anchors the aggregate dataset hash, not this row.
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Medical adverse event — category taxonomy grounded in MedDRA's System
// Organ Class structure (VAERS/EudraVigilance convention) but trimmed to
// what's actually been reported for COVID vaccines, not the full ~26 SOCs.
// Oncology fields follow the classification used in the 2026 Oncotarget
// signal review (de novo / recurrence / hyperprogression / atypical site).
// ---------------------------------------------------------------------------

enum MedicalSymptomCategory {
  CARDIOVASCULAR // myocarditis, pericarditis, clotting
  NEUROLOGICAL // acute/structural events only — Guillain-Barré, neuropathy, seizure, stroke
  NEUROCOGNITIVE_PVS // brain fog, memory/concentration impairment — emerging "Post-Vaccination
  // Syndrome" cluster; see cognitive*/postExertionalMalaise fields below.
  // Split out from NEUROLOGICAL: VAERS analyses show cognitive-impairment
  // reports at PRR 118 vs. influenza vaccine, and a 2026 Japanese 14-clinic
  // registry found brain fog/dizziness dominating 22.3% of reported events —
  // this is the single largest reported cluster, not a rare tail event, and
  // bundling it with Guillain-Barré-type events would blur exactly the signal
  // a thesis would want to cite.
  AUTOIMMUNE_IMMUNE
  HEMATOLOGIC
  ONCOLOGIC // see cancer* fields below — only meaningful when this is set
  REPRODUCTIVE_MENSTRUAL
  MUSCULOSKELETAL // incl. SIRVA-type injection-site injury
  DERMATOLOGIC
  GENERAL_SYSTEMIC // fatigue, fever — the single most common VAERS bucket
  // No DEATH value here, deliberately — MedicalSeriousness.DEATH already
  // covers this correctly (it's one of FDA's own six "serious AE" criteria).
  // A DEATH category value here would let symptomCategory and seriousness
  // independently assert contradictory things about the same fact — the
  // fix is making that unrepresentable, not detecting it after the fact. A
  // fatal outcome with no known underlying system uses OTHER + DEATH, not a
  // redundant category of its own. User catch, 2026-08-20.
  OTHER
}

enum CognitiveSymptomType {
  BRAIN_FOG
  MEMORY_IMPAIRMENT
  CONCENTRATION_DIFFICULTY
  MULTIPLE
  OTHER
}

// Whether the reported symptom resolved or is still ongoing. Schema-wide —
// not scoped to any one category. Motivated by NEUROCOGNITIVE_PVS (PVS is
// clinically defined by persistence, commonly a 3-month long-COVID-style
// threshold, not mere presence) but the same distinction is evidentiary for
// every category: an ongoing cardiac symptom, an unresolved autoimmune
// flare, and a resolved rash are not the same claim. Applies uniformly
// rather than per-category so a later real category doesn't silently lack
// it — see feedback-audit-trust-critical-callsites.md on not leaving this
// kind of gap for a future pass.
enum SymptomPersistence {
  RESOLVED
  ONGOING_PERSISTENT
  UNKNOWN
}

// VAERS/FDA's own legal "serious AE" criteria — not an invented scale.
enum MedicalSeriousness {
  HOSPITALIZATION
  LIFE_THREATENING
  PERMANENT_DISABILITY
  DEATH
  CONGENITAL_ANOMALY
  NONE
}

enum CancerPresentationType {
  NEW_DIAGNOSIS
  RECURRENCE_OR_PROGRESSION
  OTHER
}

// UNUSUALLY_RAPID_PROGRESSION is the literature's own term ("hyperprogression")
// for what's colloquially called "turbo cancer" — same claim, defensible framing.
// See defamation-risk.md Rule 2: never assert beyond what's documented.
enum CancerCourse {
  TYPICAL_PACE
  UNUSUALLY_RAPID_PROGRESSION
  // Closes the gap flagged in the dev plan (§5 Phase 2): a reporter who does
  // not know how fast the disease progressed previously had no honest answer,
  // because unlike CancerType (NOT_YET_TYPED) this enum had no "don't know"
  // member. Leaving the field null was the only option, which made "declined
  // to answer" and "actively does not know" indistinguishable in aggregation.
  // Last, so schema order stays UI display order (see reportLabelParity.test.ts).
  UNKNOWN
}

enum CancerType {
  LYMPHOMA_LEUKEMIA
  BREAST
  LUNG
  MELANOMA_SKIN
  PANCREATIC
  BRAIN_CNS
  OTHER_SOLID
  OTHER_BLOOD
  NOT_YET_TYPED
}

enum VaccineManufacturer {
  PFIZER
  MODERNA
  ASTRAZENECA
  JOHNSON_JOHNSON
  OTHER
  UNKNOWN
}

// Replaces two independent booleans (medicalAttentionSought,
// diagnosisConfirmedByProvider) that could contradict each other —
// SOUGHT_CONFIRMED implied medicalAttentionSought=true, but nothing stopped
// diagnosisConfirmedByProvider=true with medicalAttentionSought=false being
// stored anyway. An ordinal makes that state unrepresentable instead of
// detecting it after the fact, same fix as removing the redundant
// MedicalSymptomCategory.DEATH value. User-driven design review, 2026-08-20.
enum MedicalCareEngagement {
  NOT_SOUGHT
  SOUGHT_UNCONFIRMED
  SOUGHT_CONFIRMED
  UNKNOWN
}

model MedicalAdverseEventReport {
  id String @id @default(cuid())

  symptomCategory MedicalSymptomCategory
  seriousness     MedicalSeriousness     @default(NONE)

  // Set only when symptomCategory = ONCOLOGIC; null otherwise. Not enforced
  // at the DB level — validated at the intake boundary alongside the enum.
  cancerPresentationType CancerPresentationType?
  cancerCourse           CancerCourse?
  cancerAtypicalFeatures Boolean? // injection-site or regional lymph node involvement
  cancerType             CancerType?

  // Set only when symptomCategory = NEUROCOGNITIVE_PVS; null otherwise. Same
  // validated-at-intake-boundary discipline as the cancer* fields above.
  // postExertionalMalaise co-occurrence matters because PVS is clinically
  // defined as a cluster (fatigue + PEM + dysautonomia + cognitive
  // impairment), not isolated brain fog — capturing it lets aggregation
  // distinguish "full PVS-cluster" reports from a standalone symptom.
  cognitiveSymptomType  CognitiveSymptomType?
  postExertionalMalaise Boolean? // null = unknown

  // Applies to every category, not just NEUROCOGNITIVE_PVS — see
  // SymptomPersistence's own comment for why this is schema-wide.
  symptomPersistence SymptomPersistence @default(UNKNOWN)

  vaccineManufacturer VaccineManufacturer @default(UNKNOWN)
  doseNumber          Int?

  onsetWindow           ReportTimingWindow    @default(UNKNOWN)
  // Trust-tier signal, same role as BF's evidenceId link.
  medicalCareEngagement MedicalCareEngagement @default(UNKNOWN)
  preExistingCondition  Boolean? // null = unknown

  // No free-text field, deliberately — see
  // docs/gf-adverse-event-report-schema-dev-plan.md §2.10. It never served
  // the aggregation this model exists for, it was the one field that could
  // re-identify a reporter on its own, and it was the only reason any
  // per-report human review was ever going to be needed at all.

  report Report?

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Social/economic impact — impactCategory grounded in EEOC charge data
// (9,800 of ~10,000 COVID-era charges were Title VII religious-accommodation
// denials) and DoD's own acknowledged military-discharge reinstatement
// program. FAMILY_RELATIONSHIP_RUPTURE / SOCIAL_OSTRACIZATION carry weaker
// evidentiary backing (qualitatively documented, not systematically
// quantified) — same epistemic tier as CancerCourse.UNUSUALLY_RAPID_PROGRESSION,
// and the display layer must not flatten that distinction (see prior discussion).
// ---------------------------------------------------------------------------

enum SocialEconomicImpactCategory {
  EMPLOYMENT_TERMINATION
  MILITARY_DISCHARGE
  DEMOTION_REASSIGNMENT
  DENIED_HIRE
  ACCESS_DENIAL_SERVICES // venues, travel, "vaccine passport" schemes
  ACCESS_DENIAL_HEALTHCARE // denied non-emergency care/elective procedure
  EDUCATION_ACCESS_DENIAL
  FAMILY_RELATIONSHIP_RUPTURE // estrangement, divorce, custody impact
  SOCIAL_OSTRACIZATION
  OTHER
}

enum FormalBasisAsserted {
  RELIGIOUS_ACCOMMODATION_DENIED
  MEDICAL_DISABILITY_ACCOMMODATION_DENIED
  NO_FORMAL_BASIS_STATED
  UNKNOWN
}

enum ConsequenceSeverity {
  INCOME_LOSS
  BENEFITS_LOSS
  CAREER_TRAJECTORY_IMPACT
  RELATIONSHIP_LOSS
  HOUSING_FINANCIAL_HARDSHIP
  NONE
}

// The social/economic analog of SymptomPersistence above — same underlying
// gap (nothing captured whether a reported consequence is still in effect),
// same reason it's schema-wide rather than scoped to one category. Grounded
// in a documented real mechanism, not a hypothetical: DoD's own program
// reinstates servicemembers discharged for vaccine refusal with back pay —
// a MILITARY_DISCHARGE report where that happened is a materially different
// claim from one where it didn't, and the schema must be able to say which.
enum EmploymentSector {
  HEALTHCARE
  EDUCATION
  PUBLIC_SECTOR
  PRIVATE_SECTOR
  SECURITY_SERVICES
  OTHER
  UNKNOWN
}

// An escalation ladder, ordered by how far the reporter took it. Ordinal, not a
// set of booleans, so "regulator complaint" cannot coexist with "took no action".
enum RemedyPursued {
  NONE
  INTERNAL_APPEAL
  REGULATOR_COMPLAINT
  LITIGATION
  UNKNOWN
}

enum RelationshipAffected {
  SPOUSE_PARTNER
  PARENT
  CHILD
  SIBLING
  EXTENDED_FAMILY
  FRIENDS_COMMUNITY
  MULTIPLE
  UNKNOWN
}

enum VaccinationStatus {
  RECEIVED
  NOT_RECEIVED
  PARTIALLY_RECEIVED
  // "Prefer not to say" — an honest option, not a data gap to be minimised.
  // Last, so schema order stays UI display order.
  UNDISCLOSED
}

// Calendar periods rather than an interval, split where the mandate waves
// actually fell: Israel's Green Pass (Feb 2021) in H1, the large US federal
// and employer mandates (Sep 2021 onward) in H2.
enum ReportCalendarPeriod {
  YEAR_2020_OR_EARLIER
  YEAR_2021_H1
  YEAR_2021_H2
  YEAR_2022
  YEAR_2023_OR_LATER
  UNKNOWN
}

enum SocialOutcomeStatus {
  ONGOING // consequence still in effect
  RESOLVED_REVERSED // reinstated / rehired / accommodation granted on appeal
  RESOLVED_UNCHANGED // consequence stands, no further action pending
  UNKNOWN
}

model SocialEconomicImpactReport {
  id String @id @default(cuid())

  impactCategory      SocialEconomicImpactCategory
  formalBasisAsserted FormalBasisAsserted          @default(UNKNOWN)
  consequenceSeverity ConsequenceSeverity          @default(NONE)
  outcomeStatus       SocialOutcomeStatus          @default(UNKNOWN)

  // Is there a checkable paper trail (termination letter, discharge order,
  // EEOC charge number)? Same trust-tier role as medicalCareEngagement
  // above — direct analog, not a coincidence.
  documentationAvailable Boolean? // null = unknown

  // The causal antecedent of this entire domain, and the reason a row here is
  // interpretable at all. Medical reports imply vaccination — a post-vaccination
  // adverse event cannot be reported by someone who never took it. Social and
  // economic consequences are the opposite case: the documented mass events are
  // consequences of REFUSAL (EEOC religious-accommodation denials, DoD
  // discharges — see the dev plan §2.5), while the reverse also genuinely
  // occurs (estrangement over having been vaccinated). Without this field the
  // two collapse into one indistinguishable count, and an aggregate that merges
  // them is not weak evidence, it is uninterpretable — which defeats the point
  // of a model built for aggregate signal rather than individual proof (§0).
  // UNDISCLOSED is offered deliberately rather than forcing an answer; those
  // rows must be excluded from any directional claim, never counted as either.
  vaccinationStatus VaccinationStatus @default(UNDISCLOSED)

  // Conditional follow-ups, same discipline as the medical domain's
  // oncology/cognitive blocks: set only for the categories they apply to, null
  // otherwise, enforced at the intake boundary because the DB cannot express it.
  //
  // Two sub-fields were considered and deliberately NOT added, per §2.9's rule
  // that a field duplicating another is a defect rather than extra detail:
  //   - "what access was denied" — ACCESS_DENIAL_SERVICES / _HEALTHCARE /
  //     EDUCATION_ACCESS_DENIAL already carry exactly that, and a second field
  //     saying it again could disagree with the category.
  //   - a military discharge characterisation — the real published taxonomies
  //     are US DoD's (Honorable / General / Other-Than-Honorable), which do not
  //     describe IDF service and would be inventing authority for a Hebrew-first
  //     audience. Escalation is captured by remedyPursued below, and
  //     reinstatement by outcomeStatus.RESOLVED_REVERSED, so nothing is lost.

  // Employment-consequence categories only (termination, demotion, denied hire).
  // Sector is the axis the EEOC's own COVID-era charge data is stratified by,
  // and healthcare workers were the most heavily mandated group of all.
  employmentSector EmploymentSector?

  // Employment categories plus MILITARY_DISCHARGE — the ones with a formal
  // process to escalate through. One ordinal field rather than a "did you
  // complain?" boolean beside a "what happened?" enum, so the impossible
  // combination (an outcome with no complaint) cannot be expressed at all —
  // the same fix applied to medicalCareEngagement in §2.9.
  remedyPursued RemedyPursued?

  // Relational categories only (family rupture, social ostracization). This is
  // the least systematically studied cluster in the schema (§2.5); capturing
  // which bond broke is what would make it studiable rather than anecdotal.
  relationshipAffected RelationshipAffected?

  // Replaces the shared ReportTimingWindow, which measured an interval "after
  // vaccination" — incoherent for the archetypal reporter here, who never was
  // vaccinated. A calendar period has no such anchor to be wrong about, and is
  // the more useful axis regardless: mandates arrived in dated waves, so when a
  // consequence landed is what ties it to a specific policy.
  occurredDuring ReportCalendarPeriod @default(UNKNOWN)

  // No free-text field — see MedicalAdverseEventReport's own comment; same
  // reasoning applies here.

  report Report?

  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// A debate about whether one page change should become evidence.
//
// The forensic classifier is not deterministic: re-scanning a single government
// page on 2026-08-22 flagged 5 changes where an earlier run of the same page
// flagged 10 — identical diffs, opposite verdicts on five of them. It errs in
// BOTH directions (it also once flagged a future-to-present tense change), so a
// researcher must be able to promote a change it passed over.
//
// But "a researcher clicked it" is not proof, and this platform's whole claim is
// that every status traces to something checkable. So promotion by hand requires
// an argument — and the argument is what gets kept.
//
// Modelled as a session rather than a rationale column, for the same reason
// ResearchSession exists for a thesis: it has a goal (decide this diff), a
// lifecycle, and a sequence of events that IS the record. A court reading it
// should see what was claimed, what was objected to, and how that was answered —
// not one summary field written at the end. It also survives a restart, which an
// in-memory token would not.
//
// Two standards apply, and the split is the whole design:
//
//   SUBSTANCE is a hard gate. The assessor decides whether the researcher made
//   specific, falsifiable claims about the changed content. That judges only
//   whether they argued, never whether they are right — so a fallible classifier
//   is never the final authority on significance.
//
//   MERIT is advisory. The assessor may disagree, the researcher may proceed,
//   and promotedOverObjection records that they did. Mirrors DevilsAdvocateAgent,
//   which critiques a thesis without blocking it. An override that is permitted
//   but permanently visible deters better than a refusal — and unlike a refusal,
//   it cannot be defeated by rephrasing until the model yields.
// ---------------------------------------------------------------------------

enum PromotionAssessmentVerdict {
  SUPPORTS // the argument is grounded in the diff and supports significance
  DISPUTES // the researcher argued properly, but the assessor disagrees on the merits
}

enum DiffDebateStatus {
  OPEN // under argument — no evidence exists yet
  PROMOTED // ended in promotion; evidenceId is set
  ABANDONED // the researcher withdrew the argument
}

enum DiffDebateEventType {
  DEBATE_OPENED // logged automatically when the session is created
  RATIONALE_SUBMITTED // a researcher argument — the opening one or a revision
  ASSESSMENT_RETURNED // the assessor's response to that argument
  RESPONSE_SUBMITTED // the researcher answering a sustained objection
  PROMOTED // ended in evidence; refId is the Evidence id
  ABANDONED // ended without promotion
}

// One debate per diff at a time — mirroring one ACTIVE ResearchSession per thesis.
model DiffDebateSession {
  id                    String                      @id @default(cuid())
  urlVersionDiffId      String
  urlVersionDiff        UrlVersionDiff              @relation(fields: [urlVersionDiffId], references: [id], onDelete: Cascade)
  status                DiffDebateStatus            @default(OPEN)
  // The assessor's standing verdict on the most recent argument. Null until the
  // first assessment returns.
  verdict               PromotionAssessmentVerdict?
  // Whether the most recent argument cleared the substance gate. Promotion is
  // impossible while this is false.
  hasSubstance          Boolean                     @default(false)
  // Set only when the debate ends in promotion.
  evidenceId            String?                     @unique
  evidence              Evidence?                   @relation(fields: [evidenceId], references: [id])
  promotedOverObjection Boolean                     @default(false)
  events                DiffDebateEvent[]
  createdAt             DateTime                    @default(now())
  closedAt              DateTime?
}

// One row per turn. Content is stored verbatim — this is the record, not a log.
model DiffDebateEvent {
  id        String              @id @default(cuid())
  sessionId String
  session   DiffDebateSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type      DiffDebateEventType
  content   String
  refId     String? // Evidence.id on PROMOTED
  createdAt DateTime            @default(now())
}

// ---------------------------------------------------------------------------
// One record per reclassification run.
//
// Reclassification overwrites LLM-derived columns, so the run report is the only
// place the previous verdict survives. Kept per RUN rather than per diff: the
// per-diff "before" that matters most is already preserved elsewhere — Evidence
// copies its categories at promotion time, so a promoted row carries its own
// snapshot — and full per-diff history would store badly what this stores well.
//
// It is also the measurement. When classification changes, this is what answers
// "did it help?" — which diffs flipped, in which direction, and how many of them
// already had evidence built on the old verdict.
// ---------------------------------------------------------------------------
model ReclassificationRun {
  id                 String    @id @default(cuid())
  trackedUrlId       String? // null when the run covered every tracked URL
  classifierVersion  String // the version rows were brought UP TO
  diffsExamined      Int       @default(0)
  diffsReclassified  Int       @default(0)
  // Diffs whose isLegallySignificant changed, either direction.
  flipsToSignificant Int       @default(0)
  flipsToRoutine     Int       @default(0)
  // Flips on a diff that had already produced Evidence. These need a human:
  // the Evidence row still carries the categories it was promoted with, so it
  // and its source diff now disagree.
  flipsWithEvidence  Int       @default(0)
  // JSON: Array<{ diffId, beforeDate, afterDate, before: string[], after: string[], hadEvidence: boolean }>
  // Only for diffs that flipped — an unchanged verdict needs no record.
  flips              String    @default("[]")
  startedAt          DateTime  @default(now())
  finishedAt         DateTime?
}

// ---------------------------------------------------------------------------
// How one claim moved across a page's whole archived history.
//
// The finding no individual diff can see. A diff compares two snapshots; a
// trajectory follows one assertion across all of them — "present, removed,
// restored, removed, restored, removed, and never returned" over six months.
// On corona.health.gov.il the 4th-dose efficacy figures did exactly that six
// times, and every diff that contained them saw only its own single step.
//
// Deliberately NOT an Evidence row. Evidence is point-in-time by construction:
// one evidenceDate, one urlVersionDiffId (@unique), one fileHash over one
// document. A trajectory is an interval with internal structure, and forcing it
// into that shape would make it assert something the schema cannot hold.
//
// Deliberately NOT anchored on-chain either, for the same reason a
// UrlVersionDiff is not: it is DERIVABLE from snapshots that are already
// anchored individually. Anyone can take the archived snapshots, search them
// for the claim text, and recompute this exactly. An anchor would add nothing
// but the appearance of authority.
//
// That verifiability is why presence is computed against UrlSnapshot.fullText
// rather than against the AI-extracted diff items. Extracted items would make a
// trajectory depend on extraction quality and drift when the prompt changes;
// raw text makes it a string search anyone can repeat against web.archive.org.
// Extraction is used only to DISCOVER which claims are worth following.
//
// Citation is deliberately left open. A thesis cites by fileHash and
// ThesisMention knows KEY_FIGURE | EVIDENCE | TRACKED_URL; a trajectory is none
// of those. That decision is better made against real trajectories than against
// an imagined use.
// ---------------------------------------------------------------------------

enum ClaimFinalState {
  PRESENT // the claim is on the page as of the most recent snapshot
  REMOVED // it was there and is not any more
}

// One completed detection pass over a tracked URL, and the state it ran against.
//
// A trajectory is a function of three inputs, and every one can change without
// the others:
//
//   1. the ordered snapshot set   — changes when the URL is scanned
//   2. the candidate claim set    — changes on a scan OR a reclassification,
//                                   since candidates come from UrlVersionDiff
//                                   extraction, which `forensics:reclassify`
//                                   rewrites without touching the archive
//   3. the detection procedure    — changes on a code deploy
//
// sourceStateHash covers all three, with detectionVersion standing for the WHOLE
// procedure rather than a list of named knobs: the presence test is detection
// logic just as much as the normaliser is, and an enumerating hash would miss a
// change to it. Same organ as UrlVersionDiff's classifierVersion +
// classifierPromptHash, for the same reason — a stored derived value with no
// provenance silently means different things on different rows.
//
// It does double duty. As a CACHE KEY it makes detection a read instead of a
// ~4-second full-text rescan on every call. As a VERSION KEY it makes a
// trajectory immutable once computed: a later scan writes a NEW computation
// rather than mutating this one, so a thesis that cited a trajectory still
// resolves to exactly what it cited. Everything else citable here is immutable
// by construction (a snapshot is fixed text, a diff has fixed endpoints, an
// Evidence hash covers fixed content); without this, a trajectory would have been
// the only citable artifact able to change meaning after the fact.
// A correction to an evidence summary, and the text it replaced.
//
// Evidence.summary for a forensic finding is UrlVersionDiff.aiSignificance copied
// verbatim — the classifier's DIFF-LEVEL prose, free-form by design while the
// per-item exactQuote beside it is verbatim. The pipeline promotes the paraphrase
// layer to be the record's public prose, and nothing compared it to the quotes it
// summarises. One anchored record described the page as presenting side effects as
// passing within a day or two; the archived text says they APPEAR a day or two
// after. Onset paraphrased into duration, and a downstream assessor repeated it.
//
// Correcting such a summary is safe for the anchor and must be recorded anyway.
// Safe because the evidence fileHash covers url + date + deletedText + addedText —
// the change itself, deliberately not the prose — so the on-chain claim is
// untouched. Recorded because a record whose public text can be edited with no
// trace is exactly the "trust us" this platform exists not to be.
//
// Append-only. A later correction writes another row; nothing here is updated.
model SummaryCorrection {
  id               String         @id @default(cuid())
  urlVersionDiffId String
  urlVersionDiff   UrlVersionDiff @relation(fields: [urlVersionDiffId], references: [id], onDelete: Cascade)
  // Denormalised so a correction stays legible if the diff is ever detached.
  fileHash         String
  previousText     String
  correctedText    String
  // Why, in the corrector's own words. A correction with no stated reason is
  // indistinguishable from a quiet rewrite.
  reason           String
  correctedById    String?
  correctedBy      Researcher?    @relation(fields: [correctedById], references: [id])
  createdAt        DateTime       @default(now())

  @@index([urlVersionDiffId, createdAt])
  @@index([fileHash])
}

model ClaimTrajectoryComputation {
  id                   String            @id @default(cuid())
  trackedUrlId         String
  trackedUrl           TrackedUrl        @relation(fields: [trackedUrlId], references: [id], onDelete: Cascade)
  // SHA-256 over (ordered snapshot timestamps, sorted candidate claim hashes,
  // detection version). Recomputing against identical state yields this row.
  sourceStateHash      String
  detectionVersion     String
  snapshotsExamined    Int
  candidatesConsidered Int
  // Candidate quotes matching no snapshot — usually a paraphrased extraction.
  // Kept because a high count means candidate discovery is degrading, which is
  // invisible if only the successes are stored.
  candidatesUnmatched  Int
  computedAt           DateTime          @default(now())
  trajectories         ClaimTrajectory[]

  @@unique([trackedUrlId, sourceStateHash])
  @@index([trackedUrlId, computedAt])
}

model ClaimTrajectory {
  id            String                     @id @default(cuid())
  // The pass that produced this row. Rows are never updated in place: a new
  // sourceStateHash means a new computation and a new set of rows.
  computationId String
  computation   ClaimTrajectoryComputation @relation(fields: [computationId], references: [id], onDelete: Cascade)
  trackedUrlId  String
  trackedUrl    TrackedUrl                 @relation(fields: [trackedUrlId], references: [id], onDelete: Cascade)
  // SHA-256 of the whitespace-normalised claim text — stable across every
  // computation, so the same assertion can be followed between passes.
  claimHash     String
  claimText     String
  // JSON: Array<{ snapshotDate, waybackTimestamp, snapshotUrl, present: boolean }>
  // Every snapshot examined, in date order — including the ones where the claim
  // was absent. The absences are half the finding.
  observations  String
  // How many times presence flipped. 1 is an ordinary removal, already visible
  // as a diff. 2 or more is the pattern no single diff can show.
  //
  // Every detected trajectory is stored, including 0- and 1-transition ones, so
  // that minTransitions stays a READ filter. Storing only what the current
  // threshold returns would make the cache depend on the query, and lowering the
  // threshold would silently serve an incomplete answer from cache. A
  // 0-transition row is also evidentially interesting in its own right: it is the
  // claim that survived every revision around it.
  transitions   Int
  firstSeen     String // YYYY-MM-DD of the earliest snapshot containing the claim
  lastSeen      String // YYYY-MM-DD of the latest snapshot containing it
  finalState    ClaimFinalState
  // SHA-256 of the presence vector — the identity of the MOVEMENT, shared by
  // every claim that came and went on the same captures.
  //
  // Derived from observations and stored anyway, because reading it is the whole
  // point: answering "how many claims moved as one unit" used to mean loading
  // every sibling row's observations blob on every thesis page load. Written by
  // presencePatternHash(), the same function grouping uses, so the two cannot
  // drift.
  //
  // Storable only because it is fixed WITHIN a computation. Across computations
  // it changes whenever a capture is added, which is why a group still has no
  // citable identity and a thesis cites every member instead.
  patternHash   String
  createdAt     DateTime                   @default(now())

  @@unique([computationId, claimHash])
  @@index([trackedUrlId, claimHash])
  @@index([computationId, patternHash])
}

/// What became of a capture the CDX index told us exists.
enum CdxEntryStatus {
  /// We hold it. `snapshotId` points at the capture.
  STORED
  /// CDX indexes it and the replay will not serve it — HTTP 404, reproduced and
  /// durable. `20240829085520` on the tracked MOH page is the known instance.
  /// A THIRD-PARTY FACT rather than a transient failure, so nobody keeps retrying
  /// it. It previously existed only as a string inside a scan job's JSON blob.
  UNSERVABLE
  /// CDX told us it exists; we have not fetched it, or the fetch failed in a way
  /// that may be transient. Distinct from UNSERVABLE deliberately — collapsing
  /// them makes a permanent gap and a retryable one indistinguishable.
  UNFETCHED
  /// Fetched, compared, and found identical AT THE TEXT LEVEL to the capture
  /// immediately preceding it — so no separate capture exists. THE NOVELTY RULE
  /// WORKING, NOT A FAILURE.
  ///
  /// The name is deliberately the write path's own: `RecordedCapture.outcome` is
  /// already `CREATED | UNCHANGED | EXISTS`, and UNCHANGED there means exactly
  /// this. One concept, one word, in both layers.
  ///
  /// It exists because UNFETCHED would assert "we never looked" about eleven of
  /// the twelve indexed captures this corpus holds no row for, when the truth is
  /// "we looked and decided" — the same never-looked-versus-nothing-there
  /// conflation this table was built to end, one layer down. A note in a plan
  /// does not protect a query: without this, "which entries have we never looked
  /// at" returns eleven false positives.
  UNCHANGED
}

/// ONE ENTRY THE CDX INDEX REPORTED, AND WHEN IT REPORTED IT.
///
/// Models what the Archive says EXISTS, as opposed to what we managed to store —
/// something this platform has never modelled. Three facts previously discarded
/// or trapped inside `WaybackScrapeJob.snapshotsList` JSON live here: the
/// published digest, the unservable capture, and the link from an index entry to
/// the capture made from it.
///
/// OBSERVATIONS, NEVER CURRENT TRUTH. Every row carries `observedAt` and means
/// "the Archive told us this, then". A live query answers "what does the Archive
/// hold NOW"; these rows answer "what did it tell us, and WHEN". Asserting the
/// first from the second is the self-referential verification Level 1 was
/// reopened twice to escape — enforced by test/liveArchiveObservers.test.ts, not
/// by this comment.
model CdxIndexEntry {
  id                   String         @id @default(cuid())
  trackedUrlId         String
  trackedUrl           TrackedUrl     @relation(fields: [trackedUrlId], references: [id], onDelete: Cascade)
  waybackTimestamp     String
  /// The digest CDX PUBLISHED for this capture — base32(SHA-1) of the response
  /// body — as observed at `observedAt`.
  ///
  /// NOT an input to Level 1's completion criterion. That criterion's whole value
  /// is that its right-hand side comes from outside this platform, and reading it
  /// from here would make the external axis a second internal check while every
  /// count stayed green.
  digest               String
  status               CdxEntryStatus
  /// WHEN THE ARCHIVE TOLD US THIS. Not when it became true.
  observedAt           DateTime
  /// The capture we made from this entry, when we hold one.
  snapshotId           String?        @unique
  snapshot             UrlSnapshot?   @relation("CdxEntryCapture", fields: [snapshotId], references: [id], onDelete: SetNull)
  /// WHAT AN `UNCHANGED` VERDICT WAS COMPUTED AGAINST.
  ///
  /// Three of the four statuses are FACTS and stay true: a row exists or it does
  /// not (STORED), the Archive serves it or refuses (UNSERVABLE), we looked or we
  /// did not (UNFETCHED). `UNCHANGED` is the odd one — it is a JUDGEMENT relative
  /// to a corpus state, meaning "its text equals the capture immediately
  /// preceding it". Store a capture between those two timestamps and the
  /// predecessor changes, and the judgement may no longer hold.
  ///
  /// Unlikely but not hypothetical: the Archive can back-fill an OLDER capture,
  /// which is precisely the case that would invalidate a neighbour's verdict
  /// silently. §3 answers it — record what the verdict was computed against — and
  /// this is the same discipline as `sourceStateHash` on trajectory computations.
  /// Without it the system would carry one verdict that can quietly stop being
  /// true.
  ///
  /// Deliberately NOT unique: many entries can be judged against one predecessor.
  comparedToSnapshotId String?
  comparedTo           UrlSnapshot?   @relation("CdxEntryComparedTo", fields: [comparedToSnapshotId], references: [id], onDelete: SetNull)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  /// UNIQUE ON THE DIGEST TOO, AND THAT IS THE WHOLE POINT.
  ///
  /// Keyed on (trackedUrlId, waybackTimestamp) alone, a re-observation would
  /// update in place and INDEX DRIFT WOULD BE INVISIBLE — destroying the
  /// capability this table was partly built for. Including the digest means a
  /// changed answer from the Archive becomes a SECOND ROW: one row normally, two
  /// only if the index ever changes what it publishes for a timestamp.
  ///
  /// Same rule as capture novelty, one layer out: store the observation, add a
  /// row only when the content differs. Growth is bounded by actual change rather
  /// than by scan count.
  @@unique([trackedUrlId, waybackTimestamp, digest])
  @@index([trackedUrlId, status])
  @@index([trackedUrlId, waybackTimestamp])
}

/// ONE QUESTION PUT TO THE CDX INDEX, AND WHAT CAME BACK.
///
/// Needed even with CdxIndexEntry, and the reason is the case Level 2 Phase B
/// routes on: A QUERY RETURNING ZERO ROWS CREATES ZERO ENTRIES, so an empty
/// result is indistinguishable from never having asked unless the ASKING is
/// itself recorded. §3: an observation of an external system must be stored,
/// because it cannot be re-derived.
///
/// It also removes the inference left behind by the fix to "a scan that fetches
/// nothing reports success". `WaybackScrapeJob.totalSnapshots` carries a
/// pagination sentinel (MAX_SNAPSHOTS + 1) AND a row count, so reading "we asked
/// and there is nothing newer" out of it would be one field carrying two
/// meanings — the exact defect that produced that bug.
///
/// APPEND-ONLY, AND NOT MERELY BECAUSE IT IS CONVENIENT. Nothing in this system
/// is deleted; Level 10 supersedes rather than removes, and an append-only log of
/// observations is that rule applied to a new table. Do not add a retention job:
/// it would quietly contradict the deletion rule, and the sequence of empty
/// answers is precisely the evidence that would justify declaring a page
/// unarchivable.
model CdxQuery {
  id           String     @id @default(cuid())
  trackedUrlId String
  trackedUrl   TrackedUrl @relation(fields: [trackedUrlId], references: [id], onDelete: Cascade)
  queriedAt    DateTime
  /// The CDX `from=` bound used, or null for an unbounded query.
  fromDate     String?
  /// Rows CDX returned. ZERO IS THE POINT OF THIS TABLE.
  rowCount     Int
  /// Whether CDX signalled further pages beyond this batch.
  hasMore      Boolean
  createdAt    DateTime   @default(now())

  @@index([trackedUrlId, queriedAt])
}
