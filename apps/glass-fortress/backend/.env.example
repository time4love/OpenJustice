# Copy this file to .env and fill in the values. Never commit .env to source control.

# Server
PORT=3000
NODE_ENV=development

# 'production' | 'staging'. Unset means production — the variable is deliberately
# absent from the production deployment, and a missing variable must never be
# able to change how the public site behaves.
APP_ENV=staging

# Supabase project ref this deployment is allowed to talk to. When set, the
# server refuses to boot against any other project. Set it on every deployed
# environment: prod and staging share a pooler hostname and are told apart only
# by this ref, so without the pin a copied DATABASE_URL boots silently.
# Find it in: Supabase Dashboard → Project → Settings → General → Reference ID
EXPECTED_SUPABASE_PROJECT_REF=

# Deployed frontend origin — added to CORS allowlist (e.g. https://glass-fortress.vercel.app)
FRONTEND_URL=http://localhost:3001

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Web3 — address of the deployed EvidenceRegistry contract
EVIDENCE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
# Private key of the wallet holding REGISTRAR_ROLE (AI Backend wallet)
REGISTRAR_PRIVATE_KEY=your_registrar_private_key_here
# RPC endpoint (local Anvil default shown)
RPC_URL=http://127.0.0.1:8545

# Google Gemini — embeddings (VectorStoreService) + default LLM provider
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Provider per agent — 'gemini' (default) or 'anthropic'
# Swap any agent back to Anthropic at any time with no code changes.
INTAKE_PROVIDER=gemini
LEGAL_PROVIDER=gemini
TRUST_PROVIDER=gemini
THESIS_PROVIDER=gemini

# Dark Vault — PostgreSQL via Supabase
# Also backs semantic search (pgvector) — see VectorStoreService.
# Get this from: Supabase Dashboard → Project → Settings → Database → Connection string (URI mode)
# Use the "Transaction" pooler URL for serverless environments (Render/Vercel):
#   postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Supabase — Auth + Storage
# Get these from: Supabase Dashboard → Project → Settings → API
SUPABASE_URL=https://[project-ref].supabase.co
# Anon key — used by the server-side JWT verifier (requireSupabaseAuth middleware)
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service Role key (secret) — used for storage uploads. Never expose client-side.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Direct DB connection — required by Prisma for migrations (bypasses PgBouncer)
# Get from: Supabase Dashboard → Settings → Database → Direct connection
DIRECT_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# MCP token HMAC secret — used to hash per-user MCP bearer tokens
# Generate with: openssl rand -hex 32
TOKEN_HMAC_SECRET=replace_with_64_char_hex_string

# AES-256 key for encrypting whistleblower contact info (64 hex chars / 32 bytes)
# Generate with:  openssl rand -hex 32
PII_SECRET_KEY=replace_with_64_char_hex_string
