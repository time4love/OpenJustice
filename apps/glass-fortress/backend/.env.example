# Copy this file to .env and fill in the values. Never commit .env to source control.

# Server
PORT=3000
NODE_ENV=development

# 'production' | 'staging'. Unset means production — the variable is deliberately
# absent from the production deployment, and a missing variable must never be
# able to change how the public site behaves.
APP_ENV=staging

# Supabase project ref this deployment is allowed to talk to. When set, the
# server refuses to boot against any other project. Set it on every deployed
# environment: prod and staging share a pooler hostname and are told apart only
# by this ref, so without the pin a copied DATABASE_URL boots silently.
# Find it in: Supabase Dashboard → Project → Settings → General → Reference ID
EXPECTED_SUPABASE_PROJECT_REF=

# Deployed frontend origin — added to CORS allowlist (e.g. https://glass-fortress.vercel.app)
FRONTEND_URL=http://localhost:3001

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Web3 — address of the deployed EvidenceRegistry contract
EVIDENCE_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
# Private key of the wallet holding REGISTRAR_ROLE (AI Backend wallet)
REGISTRAR_PRIVATE_KEY=your_registrar_private_key_here
# RPC endpoint (local Anvil default shown)
RPC_URL=http://127.0.0.1:8545

# Google Gemini — embeddings (VectorStoreService) + default LLM provider
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Provider per agent — 'gemini' (default) or 'anthropic'
# Swap any agent back to Anthropic at any time with no code changes.
INTAKE_PROVIDER=gemini
LEGAL_PROVIDER=gemini
TRUST_PROVIDER=gemini
THESIS_PROVIDER=gemini

# Dark Vault — PostgreSQL via Supabase
# Also backs semantic search (pgvector) — see VectorStoreService.
# Get this from: Supabase Dashboard → Project → Settings → Database → Connection string (URI mode)
# Use the "Transaction" pooler URL for serverless environments (Render/Vercel):
#   postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Supabase — Auth + Storage
# Get these from: Supabase Dashboard → Project → Settings → API
SUPABASE_URL=https://[project-ref].supabase.co
# Anon key — used by the server-side JWT verifier (requireSupabaseAuth middleware)
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service Role key (secret) — used for storage uploads. Never expose client-side.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Direct DB connection — required by Prisma for migrations (bypasses PgBouncer)
# Get from: Supabase Dashboard → Settings → Database → Direct connection
DIRECT_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# MCP token HMAC secret — used to hash per-user MCP bearer tokens
# Generate with: openssl rand -hex 32
TOKEN_HMAC_SECRET=replace_with_64_char_hex_string

# AES-256 key for encrypting whistleblower contact info (64 hex chars / 32 bytes)
# Generate with:  openssl rand -hex 32
PII_SECRET_KEY=replace_with_64_char_hex_string

# MCP OAuth 2.1 authorization server signing keys — persisted, never share
# across environments (a compromised key must be rotatable per-environment
# without affecting the others).
#
# MUST contain an RSA key as well as the EC one. RS256 is mandatory per OpenID
# Connect Discovery 1.0 §3, and registration here is OPEN — third-party MCP
# clients self-register, and one that does not explicitly ask for ES256
# defaults to RS256. An EC-only JWKS rejects them at registration with
# invalid_client_metadata, before they ever reach a login screen; that is
# exactly what broke every client between 2026-08-20 and 2026-08-21. The
# loader now refuses to start without an RSA key rather than let it recur.
#
# Generate both keys with:
#   node -e "const c=require('crypto');const jwk=(t,o)=>c.generateKeyPairSync(t,o).privateKey.export({format:'jwk'});console.log(JSON.stringify({keys:[jwk('rsa',{modulusLength:2048}),jwk('ec',{namedCurve:'P-256'})]}))"
#
# Without this, oidc-provider falls back to a static RSA key shipped inside
# the library itself (same key in every install worldwide, publicly on npm).
OAUTH_JWKS=

# Cookie-signing key(s) for the OAuth interaction/session cookies (Koa
# Keygrip) — comma-separated for future rotation. Generate with:
#   openssl rand -hex 32
OAUTH_COOKIE_KEYS=

# X-Staging-Token value required on every /api/* request (except /health)
# once APP_ENV=staging — unused in production. Deliberately not the
# Authorization header, which researcher/MCP and Supabase auth also read on
# the same requests for a different secret. The staging frontend sends this
# on every call; see NEXT_PUBLIC_STAGING_API_TOKEN in the frontend .env.example.
# Generate with: openssl rand -hex 24
STAGING_API_TOKEN=
