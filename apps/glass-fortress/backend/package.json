{
  "name": "glass-fortress-backend",
  "version": "0.1.0",
  "description": "",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "prisma generate && ts-node-dev --respawn --transpile-only --ignore-watch node_modules --ignore-watch dist --ignore-watch prisma src/server.ts",
    "build": "prisma generate && tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "jest --config jest.config.ts",
    "db:check-drift": "prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --exit-code",
    "db:simulate": "ts-node --transpile-only scripts/dbSimulate.ts",
    "db:deploy": "prisma migrate deploy",
    "researcher:bootstrap": "ts-node --transpile-only scripts/bootstrapResearcher.ts",
    "forensics:reclassify": "ts-node --transpile-only scripts/reclassifyDiffs.ts",
    "forensics:resummarize": "ts-node --transpile-only scripts/resummarizeDiffs.ts",
    "forensics:trajectories": "ts-node --transpile-only scripts/claimTrajectories.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@langchain/anthropic": "^1.5.1",
    "@langchain/core": "^1.2.3",
    "@langchain/google-genai": "^2.2.0",
    "@langchain/pinecone": "^1.0.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@mozilla/readability": "^0.6.0",
    "@pinecone-database/pinecone": "^8.1.0",
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.101.1",
    "axios": "^1.18.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ethers": "^6.17.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "jsdom": "^29.1.1",
    "multer": "^2.2.0",
    "oidc-provider": "^9.11.2",
    "prisma": "^5.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsdom": "^28.0.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/oidc-provider": "^9.11.0",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  }
}
