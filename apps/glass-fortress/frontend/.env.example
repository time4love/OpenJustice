# Copy this file to .env.local and fill in the values. Never commit .env.local.

# --- Production (Vercel) ---
# Set this to your Render/Railway backend URL.
# When set, the browser calls the backend directly (bypasses the Next.js proxy).
# Leave unset in development — Next.js rewrites handle /api/* locally.
NEXT_PUBLIC_API_URL=https://your-backend-url.onrender.com

# --- Development / Next.js SSR proxy ---
# Used by next.config.ts rewrites to forward /api/* to the backend.
# Only needed locally; not used when NEXT_PUBLIC_API_URL is set.
BACKEND_URL=http://localhost:3000

# --- Supabase Auth (client-side) ---
# Get these from: Supabase Dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Environment ---
# 'production' | 'staging'. Unset means production: a missing variable must
# never be able to put the public site behind a password.
# Anything other than production is password-gated and served `noindex`.
APP_ENV=staging

# Shared password for non-production environments. REQUIRED whenever
# APP_ENV != production — without it the site returns 503 rather than serving
# publicly. Generate with:  openssl rand -hex 24
STAGING_ACCESS_SECRET=replace_with_a_long_random_string

# Set to 'true' to hide the "staging" corner chip during a demo.
# Does not relax the access gate.
DEMO_MODE=

# --- Staging API access ---
# Sent as `X-Staging-Token: <token>` on every backend call, patched into
# a global fetch by src/lib/stagingApiAuth.ts. Must match STAGING_API_TOKEN
# on the staging backend. Deliberately NEXT_PUBLIC_: on staging the browser
# calls the backend directly (NEXT_PUBLIC_API_URL is set), so this ships in
# the JS bundle regardless. It is a bot/scanner deterrent, not a secret — the
# password gate's own matcher already excludes _next/static, so the bundle is
# reachable without the password today. Never reuse this value as a real
# credential. Generate with: openssl rand -hex 24
NEXT_PUBLIC_STAGING_API_TOKEN=
