# Bronze Fortress Backend — Environment Variables
# Copy to .env and fill in values from the Bronze Fortress Supabase project.
# IMPORTANT: This is a SEPARATE Supabase project from Glass Fortress. Never share keys.

# Supabase pooler (transaction mode — used by the app at runtime)
DATABASE_URL="postgresql://postgres.YOURPROJECTREF:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase pooler (session mode — used by Prisma for migrations)
DIRECT_URL="postgresql://postgres.YOURPROJECTREF:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Supabase — Bronze Fortress project (Settings → API)
SUPABASE_URL="https://YOURPROJECTREF.supabase.co"
SUPABASE_ANON_KEY=""          # publishable key (sb_publishable_...)
SUPABASE_SERVICE_ROLE_KEY="" # secret key (sb_secret_...)

# Anthropic (same API key as Glass Fortress is fine)
ANTHROPIC_API_KEY=""

# Auth — generate separately from Glass Fortress: openssl rand -hex 32
TOKEN_HMAC_SECRET=""
MCP_WRITE_TOKEN=""  # openssl rand -hex 32

# Blockchain (shared contract, separate wallet from Glass Fortress)
RPC_URL="http://127.0.0.1:8545"
PRIVATE_KEY=""
CONTRACT_ADDRESS=""
