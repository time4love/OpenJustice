// Bronze Fortress (מבצר הנחושת) — private family court pattern analysis platform
// IMPORTANT: Separate Supabase project from Glass Fortress. Separate keys. Never shared.
// Deployment: Railway (backend) + Supabase (separate project) + Vercel (frontend) — see DEPLOYMENT.md.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum CaseMemberRole {
  PRIMARY_CONTACT
  CO_PETITIONER // second parent who is also a victim — NOT the opposing parent
  LAWYER
}

enum KeyFigureType {
  JUDGE
  SOCIAL_WORKER
  EVALUATOR         // מאבחן — psychologist / psychiatrist
  GUARDIAN_AD_LITEM // אפוטרופוס לדין
  YOUTH_PROBATION   // קצין מבחן לנוער
  OTHER
}

enum KeyFigureStatus {
  PENDING // below activation threshold — invisible to petitioners
  ACTIVE  // threshold met + legal review approved
}

enum CooperationLevel {
  NONE               // Level 1: counted, no sharing
  ANONYMOUS_TIMELINE // Level 2: fuzzed timeline visible to matched families
  ANONYMOUS_MESSAGING // Level 3: platform-routed messages, no identity
  MUTUAL_INTRODUCTION // Level 4: real identity exchanged (both consented)
  SHARED_EVIDENCE_ROOM // Level 5: full encrypted workspace
}

// Pattern categories — see CLOSED_DOORS.md for full taxonomy and Hebrew labels.
// Organized by legal domain. Used in commitment hash + pattern thesis.
enum PatternCategory {
  // Domain A — Criminal-to-Family Interface
  CRIMINAL_EXONERATION_IGNORED

  // Domain B — חוק הנוער Procedural Violations
  EMERGENCY_ORDER_NO_HEARING_30_DAYS
  NZAKUT_NO_EVIDENTIARY_HEARING
  CHILD_REMOVED_OVER_YEAR_NO_HEARING

  // Domain C — Welfare Professional Violations
  WELFARE_REFERRAL_AT_FIRST_HEARING
  WELFARE_REPORT_ONE_SIDED_INTERVIEW
  WELFARE_REPORT_NO_HOME_VISIT
  WELFARE_REPORT_CITES_DROPPED_ALLEGATIONS
  WELFARE_RECOMMENDATION_CHANGED_UNEXPLAINED

  // Domain D — Evaluator Violations
  EVALUATOR_SINGLE_SESSION_UNDER_90_MIN
  EVALUATOR_SINGLE_PARENT_ONLY
  EVALUATOR_NO_FEEDBACK_SESSION
  JUDGE_RUBBER_STAMPS_EVALUATOR

  // Domain E — Guardian Ad Litem
  GUARDIAN_MINIMAL_CHILD_CONTACT
  GUARDIAN_REPEATEDLY_BY_SAME_JUDGE
  GUARDIAN_CONTRADICTS_CHILD_WISHES

  // Domain F — Judicial Conduct
  EX_PARTE_HEARING
  RECUSAL_DENIED_CONFLICT
  SYSTEMIC_HEARING_DELAYS
  MULTIPLE_JUDGE_HANDOFFS

  // Domain G — ניכור הורי (Parental Alienation)
  // Meta-pattern: weaponizes all other domains. Uses Domain A to create
  // separation, Domain B to extend it, Domain D to ratify it, Domain F to enforce it.
  // Early registration is critical — on-chain timestamp must predate the alienation campaign.
  ALIENATION_CHILD_WISHES_AS_RULING_BASIS // court used child's expressed wishes without investigating alienation
  ALIENATION_RAISED_IGNORED               // alienation raised in proceedings, not investigated
  EVALUATOR_NO_ALIENATION_ASSESSMENT      // evaluator did not screen for alienation indicators
  CONNECTED_PARENT_SYSTEM_TIES            // alienating parent has undisclosed ties to case professionals
  SEPARATION_WINDOW_USED_FOR_ALIENATION   // court-ordered separation period used to conduct alienation campaign
}

enum NzakutOrderType {
  STANDARD  // requires full evidentiary hearing before issuance
  EMERGENCY // 30-day strict limit (חוק הנוער section 4)
}

enum PoliceCaseStatus {
  OPEN
  CLOSED_LACK_OF_EVIDENCE
  CLOSED_CLEARED           // actively cleared — strongest exoneration
  CLOSED_OTHER
  UNKNOWN
}

// ─── Reference Data ───────────────────────────────────────────────────────────

// Israeli family courts — seeded from public court registry.
model Court {
  id       String @id @default(cuid())
  name     String // e.g. "בית משפט לענייני משפחה תל אביב"
  city     String
  district String

  keyFigures  KeyFigure[]
  allegations Allegation[]
  legalCases  Case[]
}

// ─── Case & Members ───────────────────────────────────────────────────────────
//
// "Case" represents the petitioning parent's legal proceedings — NOT the family
// unit. The opposing parent is a party in the proceedings, never a vault member.
// CaseMembers are the petitioning parent, their lawyer, or a co-petitioner who
// is also a victim of the same system conduct.

model Case {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // All content fields encrypted client-side before upload.
  // Server holds ciphertext only — admin cannot read case content.
  encryptedIntakeData String? // full questionnaire responses, encrypted JSON
  publicKeyHex        String  // petitioning parent's public key for E2E encryption

  cooperationLevel CooperationLevel @default(NONE)

  // The family court where these proceedings are taking place.
  // Set once by the petitioner; inherited by all pattern commitments.
  court   Court?  @relation(fields: [courtId], references: [id])
  courtId String?

  members            CaseMember[]
  consents           ConsentRecord[]
  allegations        Allegation[]
  evidenceRecords    Evidence[]
  criminalComplaints CriminalComplaint[]
  nzakutOrders       NzakutOrder[]
  welfareReports     WelfareReport[]
  evaluatorSessions  EvaluatorSession[]
  guardianContacts   GuardianContact[]

  @@map("cases")
}

model CaseMember {
  id             String         @id @default(cuid())
  legalCase      Case           @relation(fields: [caseId], references: [id])
  caseId         String
  role           CaseMemberRole
  supabaseUserId String         @unique // auth handled separately per member
  createdAt      DateTime       @default(now())

  @@map("case_members")
}

model ConsentRecord {
  id        String           @id @default(cuid())
  legalCase Case             @relation(fields: [caseId], references: [id])
  caseId    String
  tier      CooperationLevel
  grantedAt DateTime         @default(now())
  revokedAt DateTime?
  isActive  Boolean          @default(true)
}

// ─── Structured Intake — Domain-Specific Models ───────────────────────────────

// Domain A: Criminal allegations filed by one parent against the other.
// Tracks whether the criminal exoneration was acknowledged by the family court.
model CriminalComplaint {
  id        String @id @default(cuid())
  legalCase Case   @relation(fields: [caseId], references: [id])
  caseId    String

  policeStatus                 PoliceCaseStatus
  closureConsideredByCourt     Boolean?  // null = unknown
  custodyChangedAfterClosure   String?   // "worsened" | "unchanged" | "improved"
  welfareReportCitedAfterClose Boolean?  // report cited allegation despite closure

  // Real dates — will be encrypted in CD-1.3 implementation
  complaintDate DateTime?
  closureDate   DateTime?

  createdAt DateTime @default(now())

  evidence Evidence?
}

// Domain B: Tracks צו נזקקות issuance and whether evidentiary hearings occurred.
// Maps to specific violations of חוק הנוער sections 3, 4, and 7.
model NzakutOrder {
  id        String @id @default(cuid())
  legalCase Case   @relation(fields: [caseId], references: [id])
  caseId    String

  orderType              NzakutOrderType
  evidentiaryHearingHeld Boolean
  daysToFullHearing      Int?    // null = hearing never held
  childrenLocation       String? // "other_parent" | "foster" | "institution"

  // Total days child separated without a merits hearing
  daysWithoutMeritsHearing Int?

  // Real dates — will be encrypted in CD-1.3 implementation
  orderDate   DateTime?
  hearingDate DateTime?

  createdAt DateTime @default(now())

  evidence Evidence?
}

// Domain C: Welfare professional conduct — tracks whether the social worker
// followed required procedures in report preparation and hearings.
model WelfareReport {
  id        String @id @default(cuid())
  legalCase Case   @relation(fields: [caseId], references: [id])
  caseId    String

  welfareReferralAtFirstHearing Boolean  // referral made at opening hearing, before evidence
  interviewOneSided             Boolean? // report based on interview with only one party
  homeVisitConducted            Boolean? // social worker visited requesting parent's home
  citedDroppedAllegations       Boolean? // report relies on closed/unproven allegations
  recommendationChanged         Boolean? // recommendation reversed between reports without explanation

  reportDate DateTime?
  createdAt  DateTime @default(now())

  evidence Evidence?

  @@map("welfare_reports")
}

// Domain D: Evaluator (מאבחן) conduct — tracks session adequacy and procedural compliance.
model EvaluatorSession {
  id        String @id @default(cuid())
  legalCase Case   @relation(fields: [caseId], references: [id])
  caseId    String

  sessionCount              Int     // total number of sessions conducted
  totalDurationMinutes      Int?    // total evaluation time across all sessions
  bothParentsInterviewed    Boolean // were both parents assessed separately?
  feedbackSessionHeld       Boolean // was a feedback session held before submitting opinion?
  judgeAdoptedWithoutReview Boolean? // did judge adopt recommendation without independent scrutiny?

  evaluationDate DateTime?
  createdAt      DateTime @default(now())

  evidence Evidence?

  @@map("evaluator_sessions")
}

// Domain E: Guardian ad litem (אפוטרופוס לדין) conduct — tracks child contact and independence.
// appointingJudgeId is stored to detect GUARDIAN_REPEATEDLY_BY_SAME_JUDGE across cases.
model GuardianContact {
  id        String @id @default(cuid())
  legalCase Case   @relation(fields: [caseId], references: [id])
  caseId    String

  childMeetingCount        Int      // number of times guardian met the child
  positionContradictsChild Boolean? // guardian advocated against child's expressed wishes

  // KeyFigure id of the appointing judge — enables cross-case detection of
  // GUARDIAN_REPEATEDLY_BY_SAME_JUDGE without storing any family content.
  appointingJudgeFigureId String?

  appointmentDate DateTime?
  createdAt       DateTime @default(now())

  evidence Evidence?

  @@map("guardian_contacts")
}

// ─── Key Figure Registry ──────────────────────────────────────────────────────

// Families propose figures here. Invisible until activation threshold is met.
model KeyFigure {
  id           String          @id @default(cuid())
  name         String
  type         KeyFigureType
  organization String?
  status       KeyFigureStatus @default(PENDING)

  // Stable anonymous public identifier — set at activation, never changes.
  // Rendered as "{localizedRoleLabel} {publicSequence}" (e.g. "עובד סוציאלי 1").
  // Real name is never exposed publicly.
  publicSequence Int?

  // Cases that have nominated this figure (deduplicated case cuid list).
  nominatingCaseIds String[]

  court   Court?  @relation(fields: [courtId], references: [id])
  courtId String?

  // Cross-reference with public registries
  registryVerified Boolean @default(false)
  registrySource   String? // e.g. "פנקס הפסיכולוגים", "מרשם העובדים הסוציאליים"

  createdAt   DateTime  @default(now())
  activatedAt DateTime?

  allegations Allegation[]

  @@unique([type, publicSequence])
}

// ─── Evidence Parent Table ────────────────────────────────────────────────────
//
// Thin pointer from a structured intake record to the allegations it generated.
// Closes the provenance gap: an Allegation can trace back to the exact intake
// document that evidenced it, without coupling Allegations to specific intake types.
//
// Exactly one FK will be set — discriminated union. The @unique constraints
// ensure each intake record maps to at most one Evidence row.
//
// Wiring (creating Evidence rows on intake + linking Allegations) is a future task.
// The table is schema-ready so existing allegations remain valid with evidenceId = null.

model Evidence {
  id        String @id @default(cuid())
  legalCase Case   @relation(fields: [caseId], references: [id])
  caseId    String

  criminalComplaintId String?          @unique
  nzakutOrderId       String?          @unique
  welfareReportId     String?          @unique
  evaluatorSessionId  String?          @unique
  guardianContactId   String?          @unique

  criminalComplaint CriminalComplaint? @relation(fields: [criminalComplaintId], references: [id])
  nzakutOrder       NzakutOrder?       @relation(fields: [nzakutOrderId], references: [id])
  welfareReport     WelfareReport?     @relation(fields: [welfareReportId], references: [id])
  evaluatorSession  EvaluatorSession?  @relation(fields: [evaluatorSessionId], references: [id])
  guardianContact   GuardianContact?   @relation(fields: [guardianContactId], references: [id])

  allegations Allegation[]

  createdAt DateTime @default(now())

  @@map("evidence")
}

// ─── Allegations (on-chain pattern proof) ────────────────────────────────────
//
// Allegation hash: hash(caseId + "|" + keyFigureId + "|" + patternCategory + "|" + courtId)
//
// caseId IS included — each case registers its own independent on-chain allegation,
// so the timestamp belongs to that case. Legal argument: "N independent timestamps
// before any connection." Quarter/year excluded — time fragments the count.
//
// A single case intake produces multiple allegations — one per
// key figure × pattern combination observed.
//
// Registered on-chain BEFORE any case is connected to another.
// The on-chain timestamp proves independence — the timestamp precedes cooperation.

model Allegation {
  id        String    @id @default(cuid())
  legalCase Case      @relation(fields: [caseId], references: [id])
  caseId    String
  figure    KeyFigure @relation(fields: [figureId], references: [id])
  figureId  String
  court     Court     @relation(fields: [courtId], references: [id])
  courtId   String

  patternCategory PatternCategory
  allegationHash  String          @unique

  // Optional provenance link — which intake document evidenced this allegation.
  // Null for allegations created before Evidence wiring was implemented.
  evidence   Evidence? @relation(fields: [evidenceId], references: [id])
  evidenceId String?

  // Real event dates — stored here, will be encrypted in CD-1.3.
  // Used for pattern thesis context ("documented 2019–2024"), not for hash.
  eventStartDate DateTime?
  eventEndDate   DateTime?

  onChainTxHash String?
  createdAt     DateTime @default(now())

  @@unique([caseId, figureId, patternCategory, courtId])
  @@map("allegations")
}
