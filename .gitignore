# ============================================================
# Node.js / Backend
# ============================================================
node_modules/
dist/
*.tsbuildinfo

# ============================================================
# Environment & secrets — NEVER commit these
# ============================================================
.env
# Any env variant (.env.staging, .env.production.local, ...) — example files stay committable
.env.*
!.env.example
!.env.*.example

# ============================================================
# Foundry / Solidity
# ============================================================
# Compiled artifacts
out/
# Forge cache
cache/
# Anvil broadcast receipts (contain private key usage records)
broadcast/
# Coverage reports
lcov.info
coverage_html/

# ============================================================
# OS & Editor noise
# ============================================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

